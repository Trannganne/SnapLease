# Sao chep file nay thanh .env truoc khi chay Docker.
# Khong commit file .env that len GitHub.
MSSQL_SA_PASSWORD=

# Gui OTP ky hop dong qua email. Voi Gmail, dung App Password, khong dung mat khau dang nhap.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Rental Camera

# Chi bat true khi can test ma chua cau hinh SMTP. Khong bat tren moi truong that.
ELECTRONIC_SIGNATURE_RETURN_OTP_IN_RESPONSE=false

# Dang ky tai https://sandbox.vnpayment.vn/devreg/ de nhan thong tin test.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/thanh-toan/vnpay/return
# IPN phai la URL HTTPS cong khai va duoc khai bao voi VNPAY.
VNPAY_IPN_URL=
# Deep link/universal link de dua nguoi dung tro lai ung dung Flutter.
VNPAY_MOBILE_CALLBACK_URL=rentalcamera://payment-result
VNPAY_EXPIRATION_MINUTES=15

# Pepper cho HMAC-SHA256 chu ky dien tu
ELECTRONIC_SIGNATURE_PEPPER=

# Cloudinary luu anh bien ban ban giao/nhan lai. Khong dua cac khoa nay vao mobile.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_EVIDENCE_FOLDER=rental-camera/bien-ban
CLOUDINARY_MAXIMUM_MEGABYTES=10

# Optional bank transfer receiver; set locally, never copy a real account into Git.
BANK_TRANSFER_NGAN_HANG=
BANK_TRANSFER_MA_BIN=
BANK_TRANSFER_SO_TAI_KHOAN=
BANK_TRANSFER_CHU_TAI_KHOAN=

# Firebase Cloud Messaging. File service-account được mount bằng Docker secret.
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_CREDENTIALS_FILE=
