# Sao chep file nay thanh .env truoc khi chay Docker.
# Khong commit file .env that len GitHub.
MSSQL_SA_PASSWORD=

# Dang ky tai https://sandbox.vnpayment.vn/devreg/ de nhan thong tin test.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/thanh-toan/vnpay/return
# IPN phai la URL HTTPS cong khai va duoc khai bao voi VNPAY.
VNPAY_IPN_URL=
# Deep link/universal link de dua nguoi dung tro lai ung dung Flutter.
VNPAY_MOBILE_CALLBACK_URL=rentalcamera://payment-result
VNPAY_EXPIRATION_MINUTES=15

# Cau hinh SMTP gui Email (Vi du: Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_SENDER_NAME=SnapLease

# Pepper cho HMAC-SHA256 chu ky dien tu
ELECTRONIC_SIGNATURE_PEPPER=

# Optional bank transfer receiver; set locally, never copy a real account into Git.
BANK_TRANSFER_NGAN_HANG=
BANK_TRANSFER_MA_BIN=
BANK_TRANSFER_SO_TAI_KHOAN=
BANK_TRANSFER_CHU_TAI_KHOAN=
