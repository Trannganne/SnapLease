@model NhanVien
@{ViewData["Title"]="Chỉnh sửa nhân viên";var branches=ViewBag.Branches as List<CuaHang> ?? new();}
<div class="page-head"><div><h1>Chỉnh sửa nhân viên</h1><p>@Model.MaNhanVien</p></div></div>
<form method="post" class="panel row g-3">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.MaNhanVien"/><div class="col-md-6"><label class="form-label">Họ tên</label><input name="hoTen" value="@Model.HoTen" required class="form-control" /></div><div class="col-md-6"><label class="form-label">Số điện thoại</label><input name="soDienThoai" value="@Model.SoDienThoai" required class="form-control" /></div><div class="col-md-6"><label class="form-label">Email</label><input name="email" value="@Model.Email" type="email" class="form-control" /></div><div class="col-md-6"><label class="form-label">Địa chỉ</label><input name="diaChi" value="@Model.DiaChi" class="form-control" /></div><div class="col-md-6"><label class="form-label">Chức vụ</label><input name="chucVu" value="@Model.ChucVu" class="form-control" /></div><div class="col-md-6"><label class="form-label">Chi nhánh</label><select name="maCuaHang" class="form-select">@foreach(var b in branches){<option value="@b.MaCuaHang" selected="@(Model.MaCuaHang==b.MaCuaHang)">@b.TenCuaHang</option>}</select></div><div class="col-md-6"><label class="form-label">Trạng thái</label><select name="trangThai" class="form-select"><option value="HOAT_DONG" selected="@(Model.TrangThai=="HOAT_DONG")">Hoạt động</option><option value="NGUNG_HOAT_DONG" selected="@(Model.TrangThai=="NGUNG_HOAT_DONG")">Ngừng hoạt động</option></select></div><div class="col-12"><button class="btn btn-primary">Lưu thay đổi</button> <a asp-action="Details" asp-route-id="@Model.MaNhanVien" class="btn btn-outline-secondary">Hủy</a></div></form>
