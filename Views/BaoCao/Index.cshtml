@model RentalCamera.ViewModels.ReportVM

@using System.Text.Json
@using System.Globalization

@{
    ViewData["Title"] = "Báo cáo thống kê";

    var ky = ViewBag.Ky as string ?? "thang";

    decimal doanhThuHienTai = Convert.ToDecimal(ViewBag.DoanhThuHienTai ?? 0);
    decimal doanhThuTruoc = Convert.ToDecimal(ViewBag.DoanhThuTruoc ?? 0);

    string kyHienTai = ViewBag.KyHienTai as string ?? "";
    string kyTruoc = ViewBag.KyTruoc as string ?? "";

    decimal chenhLech = doanhThuHienTai - doanhThuTruoc;

    decimal phanTram = doanhThuTruoc == 0
        ? 0
        : chenhLech / doanhThuTruoc * 100;

    var tinhTrang = Model.TinhTrangThietBi
        ?? new Dictionary<string, int>();

    var donTrangThai = Model.DonTheoTrangThai
        ?? new Dictionary<string, int>();

    var doanhThuLoai = Model.DoanhThuTheoLoai
        ?? new Dictionary<string, decimal>();

    string TrangThaiThietBi(string value) => value switch
    {
        "SAN_SANG" => "Sẵn sàng",
        "DANG_THUE" => "Đang thuê",
        "DANG_GIU" => "Đang giữ",
        "BAO_TRI" => "Bảo trì",
        "HONG" => "Hỏng",
        "NGUNG_KINH_DOANH" => "Ngừng kinh doanh",
        _ => value.Replace("_", " ")
    };

    string TrangThaiDon(string value) => value switch
    {
        "HOAN_THANH" => "Hoàn thành",
        "DANG_THUE" => "Đang thuê",
        "CHO_BAN_GIAO" => "Chờ bàn giao",
        "CHO_HOAN_TRA" => "Chờ hoàn trả",
        "DA_HUY" => "Đã hủy",
        _ => value.Replace("_", " ")
    };

    string LoaiDoanhThu(string value) => value switch
    {
        "TIEN_THUE" => "Tiền thuê",
        "PHI_GIA_HAN" => "Phí gia hạn",
        "PHI_PHAT" => "Phí phạt",
        _ => value.Replace("_", " ")
    };

    string[] deviceColors =
    {
        "#2878f4",
        "#64b5f6",
        "#b47bf5",
        "#ffb547",
        "#fa668c",
        "#9ba8ba"
    };

    var deviceEntries = tinhTrang
        .OrderByDescending(x => x.Value)
        .ToList();

    int totalDeviceCount = tinhTrang.Values.Sum();

    int totalOrders = donTrangThai.Values.Sum();
}

<link rel="stylesheet"
      href="~/css/pages/baocao-modern.css"
      asp-append-version="true" />

<div class="report-dashboard">

    <!-- HEADER -->
    <div class="report-heading">

        <form asp-controller="BaoCao"
              asp-action="Index"
              method="get"
              class="report-filters">

            <div class="report-filter-field">

                <label>Kỳ báo cáo</label>

                <select name="ky" class="form-select">

                    @if (ky == "tuan")
                    {
                        <option value="tuan" selected>Theo tuần</option>
                        <option value="thang">Theo tháng</option>
                    }
                    else
                    {
                        <option value="tuan">Theo tuần</option>
                        <option value="thang" selected>Theo tháng</option>
                    }

                </select>

            </div>

            <button type="submit" class="report-view-btn">

                <i class="bi bi-search"></i>
                Xem

            </button>

        </form>

    </div>

    <!-- SO SÁNH DOANH THU -->
    <div class="report-compare-grid">

        <div class="report-compare-card current">

            <div class="compare-content">

                <div class="compare-label">

                    <i class="bi bi-calendar3"></i>

                    KỲ HIỆN TẠI: @kyHienTai

                </div>

                <div class="compare-value">
                    @doanhThuHienTai.ToString("N0") đ
                </div>

                <div class="compare-growth">

                    <span class="@(chenhLech >= 0 ? "growth-positive" : "growth-negative")">

                        <i class="bi @(chenhLech >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>

                        @(chenhLech >= 0 ? "+" : "")@phanTram.ToString("N1")%

                    </span>

                    <span>
                        Chênh lệch:
                        @(chenhLech >= 0 ? "+" : "")@chenhLech.ToString("N0") đ
                    </span>

                </div>

            </div>

            <div class="compare-decoration">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>

        </div>

        <div class="report-compare-card previous">

            <div class="compare-content">

                <div class="compare-label">

                    <i class="bi bi-calendar3"></i>

                    KỲ TRƯỚC: @kyTruoc

                </div>

                <div class="compare-value">
                    @doanhThuTruoc.ToString("N0") đ
                </div>

                <div class="compare-subtitle">
                    Doanh thu kỳ trước
                </div>

            </div>

            <div class="compare-decoration">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>

        </div>

    </div>

    <!-- KPI -->
    <div class="report-kpi-grid">

        <div class="report-kpi-card">

            <div class="kpi-icon green">
                <i class="bi bi-cash-stack"></i>
            </div>

            <div class="kpi-content">

                <h3>TỔNG DOANH THU</h3>

                <strong>
                    @Model.DoanhThu.ToString("N0") đ
                </strong>

                <p>Không bao gồm tiền cọc</p>

            </div>

            <div class="kpi-decoration green">
                <i class="bi bi-graph-up-arrow"></i>
            </div>

        </div>

        <div class="report-kpi-card">

            <div class="kpi-icon blue">
                <i class="bi bi-file-earmark-text"></i>
            </div>

            <div class="kpi-content">

                <h3>ĐƠN THUÊ HỢP LỆ</h3>

                <strong>@Model.DonThanhCong</strong>

                <p>Không tính hợp đồng đã hủy</p>

            </div>

            <div class="kpi-decoration blue">
                <i class="bi bi-file-earmark"></i>
            </div>

        </div>

        <div class="report-kpi-card">

            <div class="kpi-icon purple">
                <i class="bi bi-camera"></i>
            </div>

            <div class="kpi-content">

                <h3>TỔNG THIẾT BỊ</h3>

                <strong>@Model.TongThietBi</strong>

                <p>Tổng thiết bị trong hệ thống</p>

            </div>

            <div class="kpi-decoration purple">
                <i class="bi bi-camera"></i>
            </div>

        </div>

        <div class="report-kpi-card">

            <div class="kpi-icon pink">
                <i class="bi bi-pie-chart-fill"></i>
            </div>

            <div class="kpi-content">

                <h3>TỶ LỆ ĐANG KHAI THÁC</h3>

                <strong>
                    @Model.TyLeLapDay.ToString("N1")%
                </strong>

                <p>Thiết bị đang thuê hoặc đang giữ</p>

            </div>

            <div class="kpi-decoration pink">
                <i class="bi bi-pie-chart"></i>
            </div>

        </div>

    </div>

    <!-- BIỂU ĐỒ -->
    <div class="report-charts-grid">

        <!-- DOANH THU THEO LOẠI -->
        <div class="report-panel">

            <div class="report-panel-title">

                <i class="bi bi-bar-chart-line"></i>

                <h3>BIỂU ĐỒ DOANH THU THEO LOẠI</h3>

            </div>

            <div class="revenue-chart-wrapper">

                <canvas id="revenueTypeChart"></canvas>

            </div>

            @if (!doanhThuLoai.Any())
            {
                <p class="text-center text-muted mt-3">
                    Chưa có dữ liệu doanh thu.
                </p>
            }

        </div>

        <!-- TÌNH TRẠNG THIẾT BỊ -->
        <div class="report-panel">

            <div class="report-panel-title">

                <i class="bi bi-pie-chart"></i>

                <h3>TÌNH TRẠNG THIẾT BỊ</h3>

            </div>

            <div class="equipment-chart-layout">

                <div class="equipment-donut-wrapper">

                    <canvas id="equipmentChart"></canvas>

                    <div class="donut-center">

                        <strong>@Model.TongThietBi</strong>

                        <span>thiết bị</span>

                    </div>

                </div>

                <div class="equipment-legend">

                    @for (int i = 0; i < deviceEntries.Count; i++)
                    {
                        var item = deviceEntries[i];

                        var percent = totalDeviceCount == 0
                            ? 0
                            : (decimal)item.Value / totalDeviceCount * 100;

                        var color = deviceColors[i % deviceColors.Length];

                        <div class="equipment-legend-row">

                            <div class="equipment-legend-info">

                                <span class="legend-dot"
                                      style="background:@color"></span>

                                <span class="legend-name">
                                    @TrangThaiThietBi(item.Key)
                                </span>

                                <strong>@item.Value</strong>

                                <small>@percent.ToString("N0")%</small>

                            </div>

                            <div class="equipment-progress">

                                <div style="width:@(percent.ToString("0.##", CultureInfo.InvariantCulture))%;background:@color"></div>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

    <!-- THỐNG KÊ CHI TIẾT -->
    <div class="report-bottom-grid">

        <!-- DOANH THU THEO LOẠI -->
        <div class="report-panel">

            <div class="report-panel-title">

                <i class="bi bi-cash-coin"></i>

                <h3>DOANH THU THEO LOẠI</h3>

            </div>

            <div class="table-responsive">

                <table class="report-table">

                    <thead>
                        <tr>
                            <th>Loại</th>
                            <th>Doanh thu</th>
                            <th colspan="2">Tỷ trọng</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in doanhThuLoai.OrderByDescending(x => x.Value))
                        {
                            var percent = Model.DoanhThu == 0
                                ? 0
                                : item.Value / Model.DoanhThu * 100;

                            <tr>

                                <td>
                                    <strong>@LoaiDoanhThu(item.Key)</strong>
                                </td>

                                <td>
                                    <strong>
                                        @item.Value.ToString("N0") đ
                                    </strong>
                                </td>

                                <td>
                                    @percent.ToString("N1")%
                                </td>

                                <td style="width:35%">

                                    <div class="report-progress">

                                        <div style="width:@(percent.ToString("0.##", CultureInfo.InvariantCulture))%;background:#2878f4"></div>

                                    </div>

                                </td>

                            </tr>
                        }

                        @if (!doanhThuLoai.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">
                                    Chưa có dữ liệu doanh thu.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <!-- ĐƠN THEO TRẠNG THÁI -->
        <div class="report-panel">

            <div class="report-panel-title">

                <i class="bi bi-file-earmark-text"></i>

                <h3>ĐƠN THUÊ THEO TRẠNG THÁI</h3>

            </div>

            <div class="table-responsive">

                <table class="report-table">

                    <thead>
                        <tr>
                            <th>Trạng thái</th>
                            <th>Số đơn</th>
                            <th colspan="2">Tỷ trọng</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in donTrangThai.OrderByDescending(x => x.Value))
                        {
                            var percent = totalOrders == 0
                                ? 0
                                : (decimal)item.Value / totalOrders * 100;

                            <tr>

                                <td>
                                    @TrangThaiDon(item.Key)
                                </td>

                                <td>
                                    <strong>@item.Value</strong>
                                </td>

                                <td>
                                    @percent.ToString("N1")%
                                </td>

                                <td style="width:35%">

                                    <div class="report-progress">

                                        <div style="width:@(percent.ToString("0.##", CultureInfo.InvariantCulture))%;background:#2878f4"></div>

                                    </div>

                                </td>

                            </tr>
                        }

                        @if (!donTrangThai.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">
                                    Chưa có dữ liệu hợp đồng.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {

    if (typeof Chart === "undefined") {
        console.warn("Chart.js chưa được tải.");
        return;
    }

    const revenueLabels = @Html.Raw(JsonSerializer.Serialize(
        doanhThuLoai.Keys.Select(LoaiDoanhThu).ToList()
    ));

    const revenueValues = @Html.Raw(JsonSerializer.Serialize(
        doanhThuLoai.Values.ToList()
    ));

    const equipmentLabels = @Html.Raw(JsonSerializer.Serialize(
        deviceEntries.Select(x => TrangThaiThietBi(x.Key)).ToList()
    ));

    const equipmentValues = @Html.Raw(JsonSerializer.Serialize(
        deviceEntries.Select(x => x.Value).ToList()
    ));

    const equipmentColors = @Html.Raw(JsonSerializer.Serialize(
        deviceEntries.Select((x, i) =>
            deviceColors[i % deviceColors.Length]).ToList()
    ));

    const revenueCanvas = document.getElementById("revenueTypeChart");

    if (revenueCanvas && revenueValues.length > 0) {

        new Chart(revenueCanvas, {
            type: "bar",

            data: {
                labels: revenueLabels,

                datasets: [{
                    label: "Doanh thu",
                    data: revenueValues,
                    backgroundColor: "#2878f4",
                    borderRadius: 8,
                    maxBarThickness: 65
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        display: false
                    },

                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.parsed.y.toLocaleString("vi-VN") + " đ";
                            }
                        }
                    }
                },

                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: value =>
                                Number(value).toLocaleString("vi-VN")
                        }
                    }
                }
            }
        });
    }

    const equipmentCanvas = document.getElementById("equipmentChart");

    if (equipmentCanvas && equipmentValues.length > 0) {

        new Chart(equipmentCanvas, {
            type: "doughnut",

            data: {
                labels: equipmentLabels,

                datasets: [{
                    data: equipmentValues,
                    backgroundColor: equipmentColors,
                    borderWidth: 0,
                    hoverOffset: 5
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: "73%",

                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });
    }

});
</script>