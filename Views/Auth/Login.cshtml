@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập | SnapLease</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800;900&display=swap" />
    <link rel="stylesheet" href="~/css/snaplease-login-studio.css" asp-append-version="true" />
</head>
<body>
    <main class="login-stage">
        <section class="brand-side" aria-label="Giới thiệu SnapLease">
            <div class="brand-logo"><span class="brand-icon"><i class="bi bi-camera-fill"></i></span><span><strong>Snap<span>Lease</span></strong><small>Quản trị thiết bị nhiếp ảnh</small></span></div>
            <div class="brand-content">
                <div class="eyebrow">GIẢI PHÁP QUẢN LÝ THIẾT BỊ NHIẾP ẢNH</div>
                <h1>KẾT NỐI Ý TƯỞNG<br/><em>NÂNG TẦM KHUNG HÌNH</em></h1>
                <p>SnapLease đồng hành cùng bạn trong quản lý, vận hành và phát triển kinh doanh nhiếp ảnh.</p>
                <div class="feature-row" aria-label="Các lĩnh vực quản lý">
                    <div><i class="bi bi-camera"></i><span>Quản lý thiết bị</span></div>
                    <div><i class="bi bi-file-earmark-text"></i><span>Theo dõi hợp đồng</span></div>
                    <div><i class="bi bi-bar-chart-line"></i><span>Thống kê doanh thu</span></div>
                    <div><i class="bi bi-shield-check"></i><span>Vận hành hiệu quả</span></div>
                </div>
            </div>
            <div class="brand-foot"><span><i class="bi bi-shield-lock"></i> An toàn & bảo mật</span><span><i class="bi bi-headset"></i> Hỗ trợ 24/7</span></div>
        </section>
        <section class="form-side" aria-label="Đăng nhập quản trị">
            <div class="login-card">
                <div class="card-logo"><span class="brand-icon"><i class="bi bi-camera-fill"></i></span><span><strong>Snap<span>Lease</span></strong><small>Quản trị thiết bị nhiếp ảnh</small></span></div>
                <h2>Chào mừng trở lại</h2>
                <p class="subheading">Đăng nhập để tiếp tục quản lý hệ thống</p>
                <form method="post">
                    @Html.AntiForgeryToken()
                    @if (ViewBag.Error != null) { <div class="login-error" role="alert">@ViewBag.Error</div> }
                    <label for="username">Email hoặc tên đăng nhập</label>
                    <div class="field"><i class="bi bi-envelope"></i><input id="username" name="username" autocomplete="username" placeholder="Nhập email hoặc tên đăng nhập" required /></div>
                    <label for="password">Mật khẩu</label>
                    <div class="field"><i class="bi bi-lock"></i><input id="password" name="password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required /><button type="button" class="toggle-password" aria-label="Hiện mật khẩu" aria-pressed="false"><i class="bi bi-eye"></i></button></div>
                    <div class="options"><label class="remember"><input type="checkbox" name="remember" /> Ghi nhớ đăng nhập</label><span>Quên mật khẩu? Liên hệ quản trị viên</span></div>
                    <button class="submit" type="submit"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</button>
                </form>
                <div class="contact">Chưa có tài khoản? <strong>Liên hệ quản trị viên</strong></div>
            </div>
        </section>
    </main>
    <script>
      document.querySelector('.toggle-password')?.addEventListener('click', function () {
        const field = document.getElementById('password');
        const visible = field.type === 'password';
        field.type = visible ? 'text' : 'password';
        this.setAttribute('aria-pressed', String(visible));
        this.setAttribute('aria-label', visible ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
        this.querySelector('i').className = visible ? 'bi bi-eye-slash' : 'bi bi-eye';
      });
    </script>
</body>
</html>
