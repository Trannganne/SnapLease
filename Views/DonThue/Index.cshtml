@model RentalCamera.ViewModels.OrderVM
@using RentalCamera.Models

@{
    ViewData["Title"] = "Đơn thuê & hợp đồng";

    var branches = ViewBag.ChiNhanh as List<CuaHang>
                   ?? new List<CuaHang>();

    var names = branches.ToDictionary(
        x => x.MaCuaHang,
        x => x.TenCuaHang
    );

    string BranchName(string code)
    {
        return names.TryGetValue(code, out var name)
            ? name
            : code;
    }

    string Status(string code) => code switch
    {
        "DANG_THUE" => "Đang thuê",
        "DA_HOAN_THANH" => "Hoàn thành",
        "CHO_BAN_GIAO" => "Chờ bàn giao",
        "DANG_CHON" => "Đang chọn",
        "DA_CHUYEN_HOP_DONG" => "Đã chuyển hợp đồng",
        "CHO_XAC_NHAN" => "Chờ xác nhận",
        "CHO_THANH_TOAN_COC" => "Chờ thanh toán cọc",
        "CHO_COC" => "Chờ đặt cọc",
        "CHO_PHAN_BO" => "Chờ phân bổ",
        "CHO_PHAN_BO_THIET_BI" => "Chờ phân bổ thiết bị",
        "DA_HUY" => "Đã hủy",
        _ => code?.Replace("_", " ") ?? "Không xác định"
    };

    string StatusClass(string code) => code switch
    {
        "DANG_THUE" => "sl-status-blue",
        "DA_HOAN_THANH" => "sl-status-green",
        "CHO_BAN_GIAO" => "sl-status-orange",
        "CHO_XAC_NHAN" => "sl-status-purple",
        "DA_HUY" => "sl-status-red",
        "HET_HAN" => "sl-status-red",
        _ => "sl-status-gray"
    };

    bool hasAdvancedFilter =
        !string.IsNullOrWhiteSpace(Convert.ToString(ViewBag.ChiNhanhDaChon))
        || !string.IsNullOrWhiteSpace(Convert.ToString(ViewBag.TrangThaiDaChon))
        || !string.IsNullOrWhiteSpace(Convert.ToString(ViewBag.TuNgay))
        || !string.IsNullOrWhiteSpace(Convert.ToString(ViewBag.DenNgay));
}

<div class="sl-orders-page">

    <!-- =========================================
         THANH TIÊU ĐỀ
    ========================================== -->

    <div class="sl-orders-page-heading">

        <div>
            <h2>
                <i class="bi bi-file-earmark-text"></i>
                Quản lý đơn thuê & hợp đồng
            </h2>

            <p>
                Theo dõi hợp đồng, phân bổ thiết bị,
                bàn giao và nhận trả theo chi nhánh.
            </p>
        </div>

        <div class="sl-orders-heading-icon">
            <i class="bi bi-files"></i>
        </div>

    </div>


    <!-- =========================================
         THANH BỘ LỌC THỐNG NHẤT
    ========================================== -->

    <form method="get"
          asp-action="Index"
          class="sl-orders-unified-filter">

        <div class="row g-3 align-items-end">

            <!-- MÃ HỢP ĐỒNG -->

            <div class="col-12 col-md-6 col-xl-3">

                <label class="form-label">
                    <i class="bi bi-search"></i>
                    Mã hợp đồng
                </label>

                <input type="text"
                       name="maHopDong"
                       value="@ViewBag.MaHopDong"
                       class="form-control"
                       placeholder="Nhập mã hợp đồng..." />

            </div>


            <!-- GIỮ CHỖ -->

            <div class="col-12 col-md-6 col-xl-2">

                <label class="form-label">
                    <i class="bi bi-clock-history"></i>
                    Giữ chỗ
                </label>

                <select name="giuCho"
                        class="form-select">

                    <option value="">
                        Tất cả
                    </option>

                    <option value="CON_HAN"
                            selected="@(ViewBag.GiuCho == "CON_HAN")">
                        Còn hiệu lực (20 phút)
                    </option>

                    <option value="HET_HAN"
                            selected="@(ViewBag.GiuCho == "HET_HAN")">
                        Hết hạn (20 phút)
                    </option>

                    <option value="DA_CHUYEN_HOP_DONG"
                            selected="@(ViewBag.GiuCho == "DA_CHUYEN_HOP_DONG")">
                        Đã chuyển hợp đồng
                    </option>

                </select>

            </div>


            <!-- HỢP ĐỒNG QUÁ HẠN -->

            <div class="col-12 col-md-6 col-xl-2">

                <label class="form-label">
                    <i class="bi bi-exclamation-circle"></i>
                    Hợp đồng
                </label>

                <div class="sl-orders-overdue-field">

                    <label class="sl-orders-checkbox">

                        <input type="checkbox"
                               name="quaHan"
                               value="true"
                               checked="@(ViewBag.QuaHan == true)" />

                        <span>Chỉ xem quá hạn</span>

                    </label>

                </div>

            </div>


            <!-- NÚT BỘ LỌC NÂNG CAO -->

            <div class="col-12 col-md-6 col-xl-3">

                <button type="button"
                        class="sl-orders-advanced-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#donThueAdvancedFilters"
                        aria-expanded="@(hasAdvancedFilter ? "true" : "false")"
                        aria-controls="donThueAdvancedFilters">

                    <i class="bi bi-sliders2"></i>

                    <span>Bộ lọc nâng cao</span>

                    <i class="bi bi-chevron-down sl-orders-chevron"></i>

                </button>

            </div>


            <!-- NÚT LỌC -->

            <div class="col-12 col-xl-2">

                <button type="submit"
                        class="sl-orders-search-button">

                    <i class="bi bi-search"></i>

                    <span>Lọc</span>

                </button>

            </div>

        </div>


        <!-- =========================================
             NỘI DUNG BỘ LỌC NÂNG CAO
        ========================================== -->

        <div class="collapse @(hasAdvancedFilter ? "show" : "")"
             id="donThueAdvancedFilters">

            <div class="sl-orders-advanced-content">

                <div class="sl-orders-advanced-title">

                    <div>
                        <i class="bi bi-funnel"></i>
                        Tùy chọn lọc nâng cao
                    </div>

                    <span>
                        Kết hợp nhiều điều kiện để tìm kiếm chính xác hơn
                    </span>

                </div>


                <div class="row g-3">

                    <!-- CHI NHÁNH -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <label class="form-label">
                            Chi nhánh
                        </label>

                        <select name="chiNhanh"
                                class="form-select">

                            <option value="">
                                Tất cả chi nhánh
                            </option>

                            @foreach (var branch in branches)
                            {
                                <option value="@branch.MaCuaHang"
                                        selected="@(ViewBag.ChiNhanhDaChon == branch.MaCuaHang)">

                                    @branch.TenCuaHang

                                </option>
                            }

                        </select>

                    </div>


                    <!-- TRẠNG THÁI -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <label class="form-label">
                            Trạng thái hợp đồng
                        </label>

                        <select name="trangThai"
                                class="form-select">

                            <option value="">
                                Tất cả trạng thái
                            </option>

                            @foreach (var state in new[]
                            {
                                "DANG_THUE",
                                "DA_HOAN_THANH",
                                "CHO_BAN_GIAO",
                                "DANG_CHON",
                                "DA_CHUYEN_HOP_DONG",
                                "CHO_XAC_NHAN"
                            })
                            {
                                <option value="@state"
                                        selected="@(ViewBag.TrangThaiDaChon == state)">

                                    @Status(state)

                                </option>
                            }

                        </select>

                    </div>


                    <!-- TỪ NGÀY -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <label class="form-label">
                            Từ ngày
                        </label>

                        <input type="date"
                               name="tuNgay"
                               value="@ViewBag.TuNgay"
                               class="form-control" />

                    </div>


                    <!-- ĐẾN NGÀY -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <label class="form-label">
                            Đến ngày
                        </label>

                        <input type="date"
                               name="denNgay"
                               value="@ViewBag.DenNgay"
                               class="form-control" />

                    </div>

                </div>


                <!-- THANH THAO TÁC NÂNG CAO -->

                <div class="sl-orders-advanced-footer">

                    <span>
                        <i class="bi bi-info-circle"></i>
                        Các điều kiện được kết hợp khi nhấn Lọc.
                    </span>

                    <div class="sl-orders-advanced-actions">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-counterclockwise"></i>
                            Đặt lại
                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check2"></i>
                            Áp dụng bộ lọc

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </form>


    <!-- =========================================
         DANH SÁCH HỢP ĐỒNG
    ========================================== -->

    <section class="sl-orders-list-panel">

        <div class="sl-orders-section-header">

            <div class="sl-orders-section-title">

                <div class="sl-orders-section-icon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>

                <div>
                    <h3>Danh sách hợp đồng</h3>
                    <p>Quản lý và theo dõi hợp đồng thuê thiết bị</p>
                </div>

            </div>

            <div class="sl-orders-header-actions">

    <span class="sl-orders-count-badge">
        @Model.HopDong.Count hợp đồng
    </span>

    <a asp-controller="GiaHan"
       asp-action="Index"
       class="sl-orders-renewal-btn">

        <i class="bi bi-calendar2-plus"></i>

        <span>Quản lý gia hạn hợp đồng</span>

        <i class="bi bi-arrow-right"></i>

    </a>

</div>

        </div>


        <div class="table-responsive">

            <table class="table sl-orders-table align-middle">

                <thead>
                    <tr>
                        <th>Mã hợp đồng</th>
                        <th>Khách hàng</th>
                        <th>Chi nhánh</th>
                        <th>Ngày thuê</th>
                        <th>Ngày trả</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var x in Model.HopDong)
                    {
                        <tr>

                            <td>
                                <strong class="sl-orders-code">
                                    @x.MaHopDong
                                </strong>
                            </td>

                            <td>
                                <div class="sl-orders-customer">

                                    <div class="sl-orders-avatar">
                                        <i class="bi bi-person"></i>
                                    </div>

                                    <span>
                                        @(x.KhachThue?.HoTen ?? x.MaKhachThue)
                                    </span>

                                </div>
                            </td>

                            <td>
                                <span class="sl-orders-branch-name">
                                    <i class="bi bi-shop"></i>
                                    @BranchName(x.MaCuaHang)
                                </span>
                            </td>

                            <td>
                                @x.ThoiGianBanGiao.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @x.ThoiGianTraDuKien.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                <strong class="sl-orders-money">
                                    @x.TongTien.ToString("N0") đ
                                </strong>
                            </td>

                            <td>
                                <span class="sl-orders-status @StatusClass(x.TrangThai)">
                                    @Status(x.TrangThai)
                                </span>
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@x.MaHopDong"
                                   class="sl-orders-detail-button">

                                    Chi tiết

                                    <i class="bi bi-arrow-right"></i>

                                </a>
                            </td>

                        </tr>
                    }

                    @if (Model.HopDong.Count == 0)
                    {
                        <tr>
                            <td colspan="8">

                                <div class="sl-orders-empty">

                                    <i class="bi bi-inbox"></i>

                                    <h4>Không tìm thấy hợp đồng</h4>

                                    <p>
                                        Không có hợp đồng phù hợp
                                        với điều kiện tìm kiếm.
                                    </p>

                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </section>


    <!-- =========================================
         ĐƠN / GIỎ HÀNG CHỜ XỬ LÝ
    ========================================== -->

    <section class="sl-orders-list-panel mt-3">

        <div class="sl-orders-section-header">

            <div class="sl-orders-section-title">

                <div class="sl-orders-section-icon sl-orders-icon-orange">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div>
                    <h3>Đơn / giỏ hàng chờ xử lý</h3>
                    <p>Theo dõi các yêu cầu đặt thuê và giữ chỗ</p>
                </div>

            </div>

            <span class="sl-orders-count-badge">
                @Model.GioHang.Count đơn
            </span>

        </div>


        <div class="table-responsive">

            <table class="table sl-orders-table align-middle">

                <thead>
                    <tr>
                        <th>Mã giỏ hàng</th>
                        <th>Khách hàng</th>
                        <th>Chi nhánh</th>
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var x in Model.GioHang)
                    {
                        <tr>

                            <td>
                                <strong class="sl-orders-code">
                                    @x.MaGioHang
                                </strong>
                            </td>

                            <td>
                                <div class="sl-orders-customer">

                                    <div class="sl-orders-avatar">
                                        <i class="bi bi-person"></i>
                                    </div>

                                    <span>
                                        @(x.KhachThue?.HoTen ?? x.MaKhachThue)
                                    </span>

                                </div>
                            </td>

                            <td>
                                <span class="sl-orders-branch-name">
                                    <i class="bi bi-shop"></i>
                                    @BranchName(x.MaCuaHang)
                                </span>
                            </td>

                            <td>
                                @x.NgayTao.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                <span class="sl-orders-status @StatusClass(x.TrangThai)">
                                    @Status(x.TrangThai)
                                </span>
                            </td>

                        </tr>
                    }

                    @if (Model.GioHang.Count == 0)
                    {
                        <tr>
                            <td colspan="5">

                                <div class="sl-orders-empty">

                                    <i class="bi bi-cart-x"></i>

                                    <h4>Không có đơn chờ xử lý</h4>

                                    <p>
                                        Hiện không có đơn hoặc giỏ hàng
                                        phù hợp điều kiện tìm kiếm.
                                    </p>

                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </section>


    <!-- =========================================
         TRA CỨU GIỮ CHỖ
    ========================================== -->

    <section class="sl-orders-lookup-section">

        <button type="button"
                class="sl-orders-lookup-toggle"
                data-bs-toggle="collapse"
                data-bs-target="#slReservationLookup"
                aria-expanded="false"
                aria-controls="slReservationLookup">

            <i class="bi bi-search"></i>

            Tra cứu giữ chỗ

            <i class="bi bi-chevron-down sl-orders-chevron"></i>

        </button>


        <div class="collapse"
             id="slReservationLookup">

            <div class="sl-orders-lookup-panel">

                <div class="sl-orders-lookup-heading">

                    <i class="bi bi-search"></i>

                    <div>
                        <h3>Tra cứu chi tiết giữ chỗ</h3>
                        <p>Nhập mã giữ chỗ để xem thông tin chi tiết</p>
                    </div>

                </div>


                <form asp-action="GiuChoDetails"
                      method="get"
                      class="sl-orders-lookup-form">

                    <input name="id"
                           required
                           class="form-control"
                           placeholder="Nhập mã giữ chỗ..." />

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search"></i>
                        Xem chi tiết

                    </button>

                </form>

            </div>

        </div>

    </section>

</div>


<!-- =========================================
     CSS GIAO DIỆN ĐƠN THUÊ
========================================== -->

<style>

/* Tổng thể */

.sl-orders-page {
    font-family: 'Roboto', Arial, sans-serif;
    color: #203b60;
}

/* Tiêu đề */

.sl-orders-page-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
}

.sl-orders-page-heading h2 {
    font-size: 21px;
    font-weight: 800;
    color: #123d72;
    margin: 0 0 7px;
}

.sl-orders-page-heading h2 i {
    color: #0875f5;
    margin-right: 8px;
}

.sl-orders-page-heading p {
    color: #7890ad;
    font-size: 13px;
    margin: 0;
}

.sl-orders-heading-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #eaf3ff;
    color: #0875f5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 23px;
}

/* Khung lọc */

.sl-orders-unified-filter {
    background: #fff;
    border: 1px solid #e3ebf6;
    border-radius: 17px;
    padding: 22px;
    margin-bottom: 24px;
    box-shadow: 0 6px 22px rgba(22, 63, 120, .05);
}

.sl-orders-unified-filter .form-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #28466c;
    margin-bottom: 9px;
}

.sl-orders-unified-filter .form-label i {
    color: #2684ff;
    margin-right: 5px;
}

.sl-orders-unified-filter .form-control,
.sl-orders-unified-filter .form-select {
    height: 44px;
    border: 1px solid #dce6f3;
    border-radius: 10px;
    background-color: #fff;
    color: #28466c;
    font-size: 13px;
}

.sl-orders-unified-filter .form-control:focus,
.sl-orders-unified-filter .form-select:focus {
    border-color: #2684ff;
    box-shadow: 0 0 0 3px rgba(38,132,255,.1);
}

/* Checkbox quá hạn */

.sl-orders-overdue-field {
    height: 44px;
    padding: 0 12px;
    display: flex;
    align-items: center;
    background: #f8fbff;
    border: 1px solid #dce6f3;
    border-radius: 10px;
}

.sl-orders-checkbox {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13px;
    cursor: pointer;
    margin: 0;
}

.sl-orders-checkbox input {
    width: 16px;
    height: 16px;
    accent-color: #0875f5;
}

/* Nút lọc nâng cao */

.sl-orders-advanced-button {
    width: 100%;
    height: 44px;
    border: 1px solid #bdd5ff;
    border-radius: 10px;
    background: #fff;
    color: #0866df;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: .2s;
}

.sl-orders-advanced-button:hover {
    background: #eff6ff;
    border-color: #2684ff;
}

.sl-orders-advanced-button[aria-expanded="true"] {
    background: #eff6ff;
    border-color: #2684ff;
}

.sl-orders-chevron {
    font-size: 11px;
    transition: transform .2s;
}

[aria-expanded="true"] .sl-orders-chevron {
    transform: rotate(180deg);
}

/* Nút lọc */

.sl-orders-search-button {
    width: 100%;
    height: 44px;
    border: none;
    border-radius: 10px;
    background: linear-gradient(120deg,#0875f5,#0062e8);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(0,98,232,.15);
    transition: .2s;
}

.sl-orders-search-button:hover {
    background: #005bd4;
    transform: translateY(-1px);
}

/* Bộ lọc nâng cao */

.sl-orders-advanced-content {
    margin-top: 22px;
    padding: 20px;
    border: 1px solid #e1eaf7;
    border-radius: 13px;
    background: #f7faff;
}

.sl-orders-advanced-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
}

.sl-orders-advanced-title div {
    font-size: 14px;
    font-weight: 700;
    color: #28466c;
}

.sl-orders-advanced-title div i {
    color: #0875f5;
    margin-right: 7px;
}

.sl-orders-advanced-title span {
    font-size: 12px;
    color: #8296b1;
}

/* Footer nâng cao */

.sl-orders-advanced-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-top: 20px;
    padding-top: 17px;
    border-top: 1px solid #e1eaf7;
}

.sl-orders-advanced-footer > span {
    font-size: 12px;
    color: #8296b1;
}

.sl-orders-advanced-actions {
    display: flex;
    gap: 10px;
}

/* Panel danh sách */

.sl-orders-list-panel {
    background: #fff;
    border: 1px solid #e3ebf6;
    border-radius: 17px;
    padding: 22px;
    box-shadow: 0 6px 22px rgba(22,63,120,.05);
}

.sl-orders-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 22px;
}

.sl-orders-section-title {
    display: flex;
    align-items: center;
    gap: 13px;
}

.sl-orders-section-icon {
    width: 43px;
    height: 43px;
    background: #eaf3ff;
    color: #0875f5;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
}

.sl-orders-icon-orange {
    background: #fff0dc;
    color: #ea8a15;
}

.sl-orders-section-title h3 {
    font-size: 17px;
    font-weight: 800;
    color: #173d70;
    margin: 0 0 5px;
}

