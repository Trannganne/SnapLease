@model RentalCamera.Models.HopDong
@using RentalCamera.Models
@{
 ViewData["Title"] = "Hợp đồng " + Model.MaHopDong;
 var fines = (IEnumerable<PhieuPhat>)(ViewBag.PhiPhat ?? new List<PhieuPhat>());
 var details = (IEnumerable<ChiTietHopDong>)(ViewBag.ChiTiet ?? new List<ChiTietHopDong>());
 var devices = (IEnumerable<ThietBi>)(ViewBag.ThietBi ?? new List<ThietBi>());
 var payments = (IEnumerable<ThanhToan>)(ViewBag.ThanhToan ?? new List<ThanhToan>());
 var fineTotal = fines.Where(x=>x.TrangThai!="DA_HUY").Sum(x=>x.SoTien);
 var signed = !string.IsNullOrWhiteSpace(Model.TepHopDongUrl);
 var status = Model.TrangThai;
 var stage = status switch { "CHO_THANH_TOAN_COC" => 2, "DA_KY" => 3, "CHO_BAN_GIAO" => 4, "DANG_THUE" => 5, "CHO_HOAN_TRA" => 7, "DA_HOAN_THANH" => 7, _ => 1 };
 var stages = new[]{"Đặt thuê","Tiền cọc","Phân bổ máy","Bàn giao","Đang thuê","Nhận trả","Quyết toán"};
 var isRenting = status == "DANG_THUE";
 var latestHandover = details.Where(x=>x.NgayGiaoThucTe.HasValue).OrderByDescending(x=>x.NgayGiaoThucTe).FirstOrDefault();
 var paidDeposit = payments.Where(x=>x.LoaiThanhToan=="TIEN_COC" && (x.TrangThai=="DA_THANH_TOAN" || x.TrangThai=="THANH_CONG")).Sum(x=>x.SoTien);
}
<div class="contract-page" id="contract-page" data-id="@Model.MaHopDong" data-state="@Model.TrangThai" data-fetch="@Url.Action("Fetch","SnapLease")" data-send="@Url.Action("Send","SnapLease")">
 @Html.AntiForgeryToken()
 <div class="contract-heading">
  <div><h1>Hợp đồng #@Model.MaHopDong <span class="contract-status @(isRenting?"contract-status-success":"")">@status.Replace("_", " ")</span></h1><p>Tạo ngày @Model.NgayKy?.ToString("dd/MM/yyyy HH:mm") · Theo dõi bàn giao, nhận trả và quyết toán</p></div>
  <div class="contract-toolbar"><a class="btn btn-outline-primary btn-sm" asp-action="Index"><i class="bi bi-arrow-left"></i> Danh sách</a>
  @if(signed){<a class="btn btn-outline-primary btn-sm" href="@Model.TepHopDongUrl" target="_blank" rel="noopener noreferrer"><i class="bi bi-file-earmark-pdf"></i> Xem hợp đồng</a>}
  <button class="btn btn-primary btn-sm" type="button" data-contract-tab="payment"><i class="bi bi-wallet2"></i> Thanh toán</button></div>
 </div>
 <div class="contract-steps" aria-label="Quy trình hợp đồng">
 @for(var i=0;i<stages.Length;i++){<div class="contract-step @(i+1<stage?"completed":i+1==stage?"current":"pending")"><span class="contract-step-number">@(i+1)</span><div><strong>@stages[i]</strong><small>@(i==0?Model.NgayKy?.ToString("dd/MM HH:mm"):i==3 && latestHandover!=null?latestHandover.NgayGiaoThucTe?.ToString("dd/MM HH:mm"):i+1==stage?"Hiện tại":i+1<stage?"Đã qua":"Chưa thực hiện")</small></div></div>}
 </div>
 <div class="contract-summaries">
  <article class="contract-card contract-summary"><i class="bi bi-person contract-icon"></i><div><small>Khách hàng</small><h3>@(Model.KhachThue?.HoTen ?? "Chưa có thông tin")</h3><p>@Model.KhachThue?.SoDienThoai</p><p>@Model.KhachThue?.Email</p></div></article>
  <article class="contract-card contract-summary"><i class="bi bi-calendar3 contract-icon"></i><div><small>Thời gian thuê</small><p><span>Từ</span><b>@Model.ThoiGianBanGiao.ToString("dd/MM/yyyy HH:mm")</b></p><p><span>Đến</span><b>@Model.ThoiGianTraDuKien.ToString("dd/MM/yyyy HH:mm")</b></p><span class="contract-chip">@((Model.ThoiGianTraDuKien-DateTime.Now).TotalHours>0?"Chưa đến hạn trả":"Đã đến hoặc quá hạn")</span></div></article>
  <article class="contract-card contract-summary"><i class="bi bi-cash-coin contract-icon"></i><div><small>Thanh toán</small><p>Tiền thuê <b>@Model.TongTien.ToString("N0") đ</b></p><p>Tiền cọc <b>@Model.TongTienCoc.ToString("N0") đ</b></p><p>Đã nhận cọc <b class="contract-positive">@paidDeposit.ToString("N0") đ</b></p><p>Phí phạt <b>@fineTotal.ToString("N0") đ</b></p></div></article>
  <article class="contract-card contract-summary"><i class="bi bi-file-earmark-text contract-icon"></i><div><small>Tài liệu hợp đồng</small><h3>@(signed?"Đã có tệp hợp đồng":"Chưa có tệp PDF")</h3>@if(signed){<a class="contract-document-link" href="@Model.TepHopDongUrl" target="_blank" rel="noopener noreferrer"><i class="bi bi-file-earmark-pdf"></i> Xem tài liệu <i class="bi bi-box-arrow-up-right"></i></a>}<p>Mã: @Model.MaHopDong</p><p>Hình thức ký: @Model.HinhThucKy</p></div></article>
 </div>
 <div class="contract-tabs" role="tablist" aria-label="Các nghiệp vụ hợp đồng">
  <button type="button" class="contract-tab active" data-tab="overview" role="tab" aria-selected="true"><i class="bi bi-grid"></i> Tổng quan</button>
  <button type="button" class="contract-tab" data-tab="equipment" role="tab" aria-selected="false"><i class="bi bi-camera"></i> Thiết bị đã phân bổ</button>
  <button type="button" class="contract-tab" data-tab="handover" role="tab" aria-selected="false"><i class="bi bi-box-arrow-up-right"></i> Bàn giao</button>
  <button type="button" class="contract-tab" data-tab="return" role="tab" aria-selected="false"><i class="bi bi-box-arrow-in-down-left"></i> Nhận trả</button>
  <button type="button" class="contract-tab" data-tab="payment" role="tab" aria-selected="false"><i class="bi bi-wallet2"></i> Thanh toán & phí phạt</button>
  <button type="button" class="contract-tab" data-tab="history" role="tab" aria-selected="false"><i class="bi bi-clock-history"></i> Lịch sử</button>
 </div>
 <div class="contract-tab-content contract-card">
 <section data-panel="overview" role="tabpanel">
  <div class="contract-overview">
   <article class="contract-inner"><div class="contract-panel-title"><h2>Thông tin chung</h2><a class="contract-subtle-action" asp-action="Index"><i class="bi bi-list-ul"></i> Danh sách</a></div><dl class="contract-dl"><dt>Mã hợp đồng</dt><dd>@Model.MaHopDong</dd><dt>Mã đơn thuê</dt><dd>@Model.MaGioHang</dd><dt>Khách hàng</dt><dd>@Model.KhachThue?.HoTen</dd><dt>Số điện thoại</dt><dd>@Model.KhachThue?.SoDienThoai</dd><dt>Email</dt><dd>@Model.KhachThue?.Email</dd><dt>Ngày ký</dt><dd>@Model.NgayKy?.ToString("dd/MM/yyyy HH:mm")</dd><dt>Nhân viên phụ trách</dt><dd>@Model.MaNhanVien</dd></dl><div class="contract-note"><strong><i class="bi bi-journal-text"></i> Ghi chú</strong><p>Thông tin chi tiết về tình trạng bàn giao được ghi nhận trong tab Bàn giao và Nhận trả.</p></div></article>
   <article class="contract-inner"><div class="contract-panel-title"><h2>Thiết bị đã phân bổ</h2><button type="button" class="contract-subtle-action" data-contract-tab="equipment"><i class="bi bi-arrow-left-right"></i> Quản lý thiết bị</button></div>
   @if(!devices.Any()){<div class="contract-empty">Chưa có thiết bị vật lý được phân bổ.</div>}
   @foreach(var tb in devices){<div class="contract-device contract-device-feature"><div class="contract-device-art"><i class="bi bi-camera"></i></div><div class="contract-device-copy"><strong>@(tb.DongMay?.TenDongMay ?? tb.MaDongMay)</strong><small>Dòng máy: @(tb.DongMay?.TenDongMay ?? tb.MaDongMay)</small><small>Serial: <b>@tb.SoSerial</b> · @tb.MaThietBi</small><span class="contract-chip">@tb.TrangThai.Replace("_"," ")</span></div></div>}
   <div class="contract-accessory"><strong><i class="bi bi-clipboard-check"></i> Kiểm tra phụ kiện</strong><p>Đối chiếu danh sách phụ kiện và ảnh thực tế trong biên bản bàn giao.</p><button type="button" class="contract-subtle-action" data-contract-tab="handover">Xem biên bản bàn giao <i class="bi bi-arrow-right"></i></button></div></article>
   <article class="contract-side-stack"><div class="contract-inner"><h2>Tình trạng hiện tại</h2><div class="contract-state-banner"><i class="bi bi-check-circle-fill"></i><div><strong>@(isRenting?"Thiết bị đang được khách hàng sử dụng":status.Replace("_"," "))</strong><small>Ngày trả dự kiến: @Model.ThoiGianTraDuKien.ToString("dd/MM/yyyy HH:mm")</small></div></div></div><div class="contract-inner"><h2>Nhân viên phụ trách</h2><div class="contract-staff"><span class="contract-staff-avatar"><i class="bi bi-person"></i></span><div><strong>@Model.MaNhanVien</strong><small>Nhân viên xử lý hợp đồng</small></div></div></div><div class="contract-inner"><h2>Hành động nhanh</h2><div class="contract-quick-actions"><button type="button" class="btn btn-outline-primary btn-sm" data-contract-tab="handover"><i class="bi bi-camera"></i> Bàn giao</button><button type="button" class="btn btn-outline-primary btn-sm" data-contract-tab="return"><i class="bi bi-box-arrow-in-down"></i> Nhận trả</button><button type="button" class="btn btn-outline-primary btn-sm" data-contract-tab="payment"><i class="bi bi-receipt"></i> Quyết toán</button></div></div></article>
  </div>
  <div class="contract-bottom-grid"><article class="contract-inner"><div class="contract-panel-title"><h2>Lịch sử hoạt động</h2><button type="button" class="contract-subtle-action" data-contract-tab="history">Xem tất cả <i class="bi bi-arrow-right"></i></button></div><div class="contract-timeline">@foreach(var d in details.Where(x=>x.NgayNhanThucTe.HasValue).OrderByDescending(x=>x.NgayNhanThucTe).Take(2)){<div class="contract-timeline-item"><time>@d.NgayNhanThucTe?.ToString("dd/MM/yyyy HH:mm")</time><span>Nhận trả thiết bị @d.MaThietBi</span></div>}@foreach(var d in details.Where(x=>x.NgayGiaoThucTe.HasValue).OrderByDescending(x=>x.NgayGiaoThucTe).Take(2)){<div class="contract-timeline-item"><time>@d.NgayGiaoThucTe?.ToString("dd/MM/yyyy HH:mm")</time><span>Bàn giao thiết bị @d.MaThietBi</span></div>}<div class="contract-timeline-item"><time>@Model.NgayKy?.ToString("dd/MM/yyyy HH:mm")</time><span>Ký hợp đồng @Model.MaHopDong</span></div></div></article><article class="contract-inner"><div class="contract-panel-title"><h2>Ảnh tình trạng thiết bị</h2><button type="button" class="contract-subtle-action" data-contract-tab="handover">Mở ảnh bàn giao <i class="bi bi-arrow-right"></i></button></div><div class="contract-photo-empty"><i class="bi bi-images"></i><p>Ảnh tình trạng được quản lý tại tab Bàn giao và Nhận trả. Chưa có API danh sách ảnh để hiển thị thư viện tại đây.</p></div></article></div>
 </section>
 <section data-panel="equipment" role="tabpanel" hidden><div class="contract-section-head"><h2>Thiết bị vật lý trong hợp đồng</h2><p>Phân bổ đúng dòng máy và kiểm tra lịch trống trước khi xác nhận.</p></div>
 @if(!devices.Any()){<p class="contract-empty">Chưa phân bổ thiết bị.</p>}
 @foreach(var tb in devices){<div class="contract-device"><i class="bi bi-camera"></i><div><strong>@(tb.DongMay?.TenDongMay ?? tb.MaDongMay)</strong><small>@tb.MaThietBi · Serial @tb.SoSerial · @tb.TinhTrang</small></div><span class="contract-chip">@tb.TrangThai.Replace("_"," ")</span></div>}
 <div class="contract-form-grid mt-3"><label>Danh sách thiết bị từ Backend<select id="contract-devices" class="form-select"><option value="">Bấm tải danh sách để chọn</option></select></label><div class="contract-action-row"><button type="button" class="btn btn-outline-primary" id="contract-load-devices">Tải thiết bị</button><button type="button" class="btn btn-primary" id="contract-assign" disabled>Phân bổ thiết bị</button></div></div><p class="contract-help" id="contract-assign-help">Chỉ cho phép phân bổ khi hợp đồng hợp lệ; Backend kiểm tra xung đột lịch và dòng máy.</p>
 </section>
 <section data-panel="handover" role="tabpanel" hidden><div class="contract-section-head"><h2>Bàn giao thiết bị</h2><p>Ghi nhận tình trạng thực tế và ảnh trước khi khách nhận máy.</p></div>
 <div class="contract-form-grid"><div class="contract-inner"><h3>Danh sách kiểm tra</h3>@foreach(var item in new[]{"Thân máy hoạt động bình thường","Ống kính không trầy xước","Pin, sạc và thẻ nhớ đầy đủ","Phụ kiện đã được kiểm đếm"}){<label class="contract-check"><input type="checkbox" class="contract-check-before"/> @item</label>}<label class="mt-3">Tình trạng trước bàn giao<textarea id="contract-before-note" class="form-control" rows="3" placeholder="Ghi rõ tình trạng thiết bị..."></textarea></label></div>
 <div class="contract-inner"><h3>Ảnh trước bàn giao</h3><label class="contract-drop"><i class="bi bi-cloud-arrow-up"></i><span>Chọn nhiều ảnh để xem trước</span><input type="file" id="contract-before-file" accept="image/*" multiple/></label><div class="contract-previews" id="contract-before-preview"></div><p class="contract-help">API hiện chỉ hỗ trợ lưu URL ảnh, chưa nhận trực tiếp tệp từ máy tính.</p><label>URL ảnh đã lưu trữ<input class="form-control" id="contract-before-url" type="url" placeholder="https://..."/></label><button type="button" class="btn btn-outline-primary mt-2" data-save-photo="BAN_GIAO">Lưu URL ảnh bàn giao</button></div></div>
 <div class="contract-action-row mt-3"><button type="button" class="btn btn-primary" id="contract-handover" @(status=="CHO_BAN_GIAO"?"":"disabled")>Xác nhận bàn giao</button></div>
 </section>
 <section data-panel="return" role="tabpanel" hidden><div class="contract-section-head"><h2>Nhận trả thiết bị</h2><p>Đối chiếu ảnh trước/sau, ghi nhận hư hỏng và xác nhận nhận lại.</p></div>
 <div class="contract-form-grid"><div class="contract-inner"><h3>Kiểm tra khi nhận trả</h3><label class="contract-check"><input type="checkbox" id="contract-damage"/> Thiết bị có hư hỏng</label><label class="mt-3">Tình trạng sau khi nhận<textarea id="contract-after-note" class="form-control" rows="3" placeholder="Mô tả tình trạng khi nhận trả..."></textarea></label><p class="contract-help">Ảnh trước bàn giao và lịch sử ảnh cần tải từ API biên bản nếu có endpoint tra cứu.</p></div><div class="contract-inner"><h3>Ảnh sau nhận trả</h3><label class="contract-drop"><i class="bi bi-cloud-arrow-up"></i><span>Chọn ảnh để xem trước</span><input type="file" id="contract-after-file" accept="image/*" multiple/></label><div class="contract-previews" id="contract-after-preview"></div><label>URL ảnh đã lưu trữ<input class="form-control" id="contract-after-url" type="url" placeholder="https://..."/></label><button type="button" class="btn btn-outline-primary mt-2" data-save-photo="NHAN_LAI">Lưu URL ảnh nhận trả</button></div></div><div class="contract-action-row mt-3"><button type="button" class="btn btn-primary" id="contract-return" @(status=="DANG_THUE"?"":"disabled")>Xác nhận nhận trả</button></div>
 </section>
 <section data-panel="payment" role="tabpanel" hidden><div class="contract-section-head"><h2>Thanh toán, phí phạt và quyết toán</h2><p>Giá trị từ dữ liệu hợp đồng và các phiếu phạt đang lưu.</p></div><div class="contract-form-grid"><div class="contract-inner"><div class="contract-money"><span>Tiền thuê</span><strong>@Model.TongTien.ToString("N0") đ</strong></div><div class="contract-money"><span>Tiền cọc dự kiến</span><strong>@Model.TongTienCoc.ToString("N0") đ</strong></div><div class="contract-money"><span>Cọc đã xác nhận</span><strong>@paidDeposit.ToString("N0") đ</strong></div><div class="contract-money"><span>Phí phạt chưa hủy</span><strong>@fineTotal.ToString("N0") đ</strong></div><div class="contract-money contract-total"><span>Tổng tiền thuê + phí phạt</span><strong>@((Model.TongTien+fineTotal).ToString("N0")) đ</strong></div><p class="contract-help">Số tiền hoàn cọc cuối cùng phải do API quyết toán xác nhận, không suy ra từ các số liệu trên.</p></div><div class="contract-inner"><h3>Giao dịch thanh toán</h3>
 @if(!payments.Any()){<p class="contract-empty">Chưa có giao dịch thanh toán.</p>}
 @foreach(var p in payments){<div class="contract-payment"><div><b>@p.LoaiThanhToan.Replace("_"," ")</b><small>@p.MaThanhToan · @p.PhuongThuc · @p.TrangThai</small></div><strong>@p.SoTien.ToString("N0") đ</strong></div>}
 <button type="button" class="btn btn-outline-primary mt-3" id="contract-load-payments">Kiểm tra tiền cọc qua API</button><div id="contract-payment-actions" class="mt-2"></div></div></div>
 @if(fines.Any()){<h3 class="mt-4">Phiếu phạt</h3><div class="table-responsive"><table class="table"><thead><tr><th>Mã</th><th>Lý do</th><th>Trạng thái</th><th class="text-end">Số tiền</th></tr></thead><tbody>@foreach(var p in fines){<tr><td>@p.MaPhieuPhat</td><td>@p.MoTa</td><td>@p.TrangThai</td><td class="text-end">@p.SoTien.ToString("N0") đ</td></tr>}</tbody></table></div>}
 <div class="contract-inner mt-3" id="settlement-panel"><h3><i class="bi bi-calculator"></i> Quyết toán từ Backend</h3><p class="contract-help">Số liệu do API tính, chỉ hoàn cọc khi hợp đồng đủ điều kiện.</p><button type="button" class="btn btn-outline-primary mb-3" id="contract-settlement-load">Tải bảng quyết toán</button><div id="contract-settlement-data" aria-live="polite"></div><div id="contract-refund-actions" class="mt-3" hidden><label class="form-label" for="contract-refund-method">Phương thức hoàn cọc</label><select id="contract-refund-method" class="form-select mb-2"><option value="TIEN_MAT">Tiền mặt</option><option value="CHUYEN_KHOAN">Chuyển khoản</option></select><label class="form-label" for="contract-refund-reference">Mã giao dịch (nếu có)</label><input class="form-control mb-2" id="contract-refund-reference" maxlength="100"/><label class="form-label" for="contract-refund-note">Nội dung hoàn cọc</label><input class="form-control mb-2" id="contract-refund-note" maxlength="500"/><button type="button" class="btn btn-primary" id="contract-refund-create">Lập giao dịch hoàn cọc</button></div><div id="contract-refund-confirm" class="mt-3"></div></div>
 </section>
 <section data-panel="history" role="tabpanel" hidden><div class="contract-section-head"><h2>Lịch sử nghiệp vụ</h2><p>Thông tin sự kiện có thể xác định từ dữ liệu hợp đồng và chi tiết bàn giao.</p></div><div class="contract-event"><time>@Model.NgayKy?.ToString("dd/MM/yyyy HH:mm")</time><span>Hợp đồng được ký</span></div>@foreach(var d in details){@if(d.NgayGiaoThucTe.HasValue){<div class="contract-event"><time>@d.NgayGiaoThucTe.Value.ToString("dd/MM/yyyy HH:mm")</time><span>Đã bàn giao @d.MaThietBi</span></div>}@if(d.NgayNhanThucTe.HasValue){<div class="contract-event"><time>@d.NgayNhanThucTe.Value.ToString("dd/MM/yyyy HH:mm")</time><span>Đã nhận trả @d.MaThietBi</span></div>}}<p class="contract-help">Nhật ký đầy đủ theo nhân viên cần endpoint audit riêng.</p></section>
 </div><div class="alert alert-info mt-3" id="contract-feedback" role="status" hidden></div>
</div>
@section Scripts { <script src="~/js/contract-details.js" asp-append-version="true" defer></script> }
