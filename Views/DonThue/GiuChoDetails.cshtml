@model RentalCamera.Models.GioHang
@{ ViewData["Title"]="Chi tiết giữ chỗ"; var items=ViewBag.Items as List<RentalCamera.Models.ChiTietGioHang> ?? new(); var branch=ViewBag.Branch as RentalCamera.Models.CuaHang; }
<div class="page-head"><h1>GIỮ CHỖ @Model.MaGioHang</h1><a asp-action="Index" class="btn btn-outline-primary">Quay lại</a></div><div class="panel p-3"><p><b>Khách:</b> @Model.KhachThue?.HoTen</p><p><b>Chi nhánh:</b> @branch?.TenCuaHang</p><p><b>Trạng thái:</b> @Model.TrangThai</p><p><b>Tạo lúc:</b> @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</p><p><b>Hạn 20 phút (ước tính theo ngày tạo):</b> @Model.NgayTao.AddMinutes(20).ToString("dd/MM/yyyy HH:mm")</p></div><div class="panel mt-3 p-3"><h3>Thiết bị đặt</h3><table class="table"><thead><tr><th>Dòng máy</th><th>Số lượng</th><th>Từ ngày</th><th>Đến ngày</th><th>Cọc</th></tr></thead><tbody>@foreach(var x in items){<tr><td>@x.DongMay?.TenDongMay</td><td>@x.SoLuong</td><td>@x.NgayBatDau.ToString("dd/MM/yyyy")</td><td>@x.NgayKetThuc.ToString("dd/MM/yyyy")</td><td>@x.TienCoc.ToString("N0")</td></tr>}</tbody></table></div>