@model System.Text.Json.JsonElement
@using System.Text.Json
@{
    Layout = null;
    string Value(JsonElement node) => node.ValueKind switch {
        JsonValueKind.String => node.GetString() ?? "—",
        JsonValueKind.Null or JsonValueKind.Undefined => "—",
        _ => node.ToString()
    };
    string Find(params string[] keys) {
        foreach (var key in keys) if (Model.ValueKind == JsonValueKind.Object)
            foreach (var p in Model.EnumerateObject())
                if (string.Equals(p.Name, key, StringComparison.OrdinalIgnoreCase)) return Value(p.Value);
        return "—";
    }
    var fields = new (string Title, string[] Keys)[] {
        ("Mã hợp đồng", new[]{"maHopDong", "MaHopDong", "id"}),
        ("Mã khách thuê", new[]{"maKhachThue", "maKhachHang", "khachThueId"}),
        ("Ngày bắt đầu", new[]{"ngayBatDau", "thoiGianNhan", "ngayNhan"}),
        ("Ngày trả dự kiến", new[]{"ngayKetThuc", "thoiGianTraDuKien", "ngayTraDuKien"}),
        ("Trạng thái", new[]{"trangThai", "status"}),
        ("Tổng tiền", new[]{"tongTien", "tongThanhToan", "thanhTien"}),
        ("Tiền cọc", new[]{"tienCoc", "tongTienCoc"})
    };
}
<!doctype html>
<html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Hợp đồng @ViewBag.ContractId - SnapLease</title>
<style>
*{box-sizing:border-box}body{font:14px Arial,sans-serif;color:#1b2435;background:#eef2f8;margin:0}.toolbar{padding:16px;text-align:center;background:#142039}.toolbar button{background:#5b44b5;color:white;border:0;border-radius:8px;padding:12px 24px;cursor:pointer}.paper{width:210mm;min-height:297mm;margin:24px auto;background:white;padding:18mm;box-shadow:0 8px 28px #0002}.brand{display:flex;align-items:center;gap:22px;border-bottom:2px solid #5b44b5;padding-bottom:18px}.brand img{width:180px;max-height:75px;object-fit:contain}.brand h1{font-size:22px;margin:0;color:#372184}.brand p{margin:6px 0;color:#637083}.hero{width:100%;height:120px;object-fit:cover;object-position:center;margin-top:18px;border-radius:8px}.meta{text-align:right;color:#687488;font-size:12px;margin:14px 0 30px}h2{text-align:center;text-transform:uppercase;font-size:20px}table{width:100%;border-collapse:collapse;margin-top:25px}th,td{border:1px solid #d8dce5;padding:11px;text-align:left;vertical-align:top}th{width:35%;background:#f4f1fc}.signatures{display:flex;justify-content:space-between;margin-top:70px;text-align:center}.signatures div{width:45%;min-height:100px}.note{font-size:12px;color:#667085;margin-top:30px}@@page{size:A4;margin:0}@@media print{body{background:white}.toolbar{display:none}.paper{margin:0;box-shadow:none;width:auto;min-height:0;break-after:auto} }
</style></head><body>
<div class="toolbar"><button type="button" onclick="window.print()">In / Lưu thành PDF</button></div>
<article class="paper">
<header class="brand"><img src="@Url.Content("~/images/logo.png")" alt="SnapLease"/><div><h1>SNAPLEASE</h1><p>Hệ thống cho thuê thiết bị nhiếp ảnh</p></div></header>
<img class="hero" src="@Url.Content("~/images/banner.png")" alt="Thiết bị nhiếp ảnh"/>
<div class="meta">Thông tin truy xuất từ Backend API · @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
<h2>Hợp đồng thuê thiết bị</h2>
<p>Thông tin hợp đồng được lấy trực tiếp từ API. Vui lòng đối chiếu trước khi ký xác nhận.</p>
<table><tbody>@foreach(var field in fields){<tr><th>@field.Title</th><td>@Find(field.Keys)</td></tr>}</tbody></table>
<div class="signatures"><div><strong>ĐẠI DIỆN CỬA HÀNG</strong><p>(Ký, ghi rõ họ tên)</p></div><div><strong>KHÁCH THUÊ</strong><p>(Ký, ghi rõ họ tên)</p></div></div>
<p class="note">Đây là bản in tóm tắt thông tin hợp đồng từ API, chưa thay thế mẫu hợp đồng pháp lý có đầy đủ điều khoản.</p>
</article></body></html>
