@model RentalCamera.Models.KhachThue
@using RentalCamera.Models

@{
    ViewData["Title"] = "Chi tiết khách hàng";

    var contracts = ViewBag.Contracts as IEnumerable<HopDong>
                    ?? Enumerable.Empty<HopDong>();
}

<div class="customer-detail-page">

    <!-- HEADER -->
    <div class="customer-detail-heading">

        <div>
            <h2>Chi tiết khách hàng</h2>

            <p>
                Thông tin cá nhân và lịch sử thuê thiết bị
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-primary">

            <i class="bi bi-arrow-left"></i>
            Danh sách

        </a>

    </div>

    <div class="customer-detail-grid">

        <!-- THÔNG TIN KHÁCH HÀNG -->
        <div class="customer-profile-card">

            <div class="customer-profile-header">

                <div class="customer-profile-avatar">
                    @(string.IsNullOrWhiteSpace(Model.HoTen)
                        ? "KH"
                        : Model.HoTen.Trim().Substring(0, 1).ToUpper())
                </div>

                <div>
                    <h3>@Model.HoTen</h3>

                    <span class="customer-code">
                        @Model.MaKhachThue
                    </span>
                </div>

            </div>

            <div class="customer-profile-info">

                <div class="customer-info-row">

                    <span>
                        <i class="bi bi-telephone"></i>
                        Số điện thoại
                    </span>

                    <strong>@Model.SoDienThoai</strong>

                </div>

                <div class="customer-info-row">

                    <span>
                        <i class="bi bi-envelope"></i>
                        Email
                    </span>

                    <strong>@Model.Email</strong>

                </div>

                <div class="customer-info-row">

                    <span>
                        <i class="bi bi-person-vcard"></i>
                        CCCD
                    </span>

                    <strong>@Model.CCCD</strong>

                </div>

                <div class="customer-info-row">

                    <span>
                        <i class="bi bi-geo-alt"></i>
                        Địa chỉ
                    </span>

                    <strong>@Model.DiaChi</strong>

                </div>

            </div>

        </div>

        <!-- LỊCH SỬ HỢP ĐỒNG -->
        <div class="customer-history-card">

            <div class="customer-card-header">

                <h3>
                    <i class="bi bi-clock-history"></i>
                    LỊCH SỬ HỢP ĐỒNG
                </h3>

                <span>@contracts.Count() hợp đồng</span>

            </div>

            <div class="table-responsive">

                <table class="table customer-table">

                    <thead>
                        <tr>
                            <th>Mã hợp đồng</th>
                            <th>Ngày ký</th>
                            <th>Ngày bắt đầu</th>
                            <th>Ngày kết thúc</th>
                            <th>Tiền thuê</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var contract in contracts)
                        {
                            <tr>

                                <td>
                                    <strong>@contract.MaHopDong</strong>
                                </td>

                                <td>
                                    @(contract.NgayKy?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")
                                </td>

                                <td>
                                    @contract.ThoiGianBanGiao.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @contract.ThoiGianTraDuKien.ToString("dd/MM/yyyy")
                                </td>

                                <td class="money">
                                    @contract.TongTien.ToString("N0") đ
                                </td>

                                <td>
                                    <span class="customer-status">
                                        @contract.TrangThai.Replace("_", " ")
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="DonThue"
                                       asp-action="Details"
                                       asp-route-id="@contract.MaHopDong"
                                       class="btn btn-outline-primary btn-sm">

                                        <i class="bi bi-eye"></i>
                                        Chi tiết

                                    </a>
                                </td>

                            </tr>
                        }

                        @if (!contracts.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center py-4 text-muted">

                                    Khách hàng chưa có hợp đồng.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>