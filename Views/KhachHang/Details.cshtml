@model KhachThue
@{ViewData["Title"]="Chi tiết khách hàng";var contracts=ViewBag.Contracts as List<HopDong> ?? new();}
<div class="page-head"><div><h1>@Model.HoTen</h1><p>Hồ sơ khách hàng · @Model.MaKhachThue</p></div><a class="btn btn-outline-primary" asp-action="Index">← Danh sách</a></div>
<div class="row g-3"><div class="col-lg-4"><section class="panel"><h3>Thông tin liên hệ</h3><div class="sl-admin-kv"><span>Điện thoại</span><b>@Model.SoDienThoai</b></div><div class="sl-admin-kv"><span>Email</span><b>@(Model.Email??"Chưa cập nhật")</b></div><div class="sl-admin-kv"><span>Địa chỉ</span><b>@(Model.DiaChi??"Chưa cập nhật")</b></div></section></div><div class="col-lg-8"><section class="panel"><h3>Lịch sử hợp đồng (@contracts.Count)</h3><div class="table-responsive"><table class="table"><thead><tr><th>Mã hợp đồng</th><th>Ngày ký</th><th>Tiền thuê</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var h in contracts){<tr><td>@h.MaHopDong</td><td>@h.NgayKy?.ToString("dd/MM/yyyy")</td><td>@h.TongTien.ToString("N0") đ</td><td>@h.TrangThai.Replace("_"," ")</td><td><a asp-controller="DonThue" asp-action="Details" asp-route-id="@h.MaHopDong">Chi tiết</a></td></tr>}@if(contracts.Count==0){<tr><td colspan="5" class="text-center text-muted">Chưa có hợp đồng.</td></tr>}</tbody></table></div></section></div></div>
