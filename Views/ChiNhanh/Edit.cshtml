@model RentalCamera.Models.CuaHang
@{ViewData["Title"]="Sửa chi nhánh";}<div class="page-head"><h1>SỬA CHI NHÁNH</h1></div><form method="post" class="panel p-3"><input type="hidden" name="id" value="@Model.MaCuaHang"/>@Html.AntiForgeryToken()<label>Tên chi nhánh</label><input class="form-control mb-2" name="tenCuaHang" value="@Model.TenCuaHang" required/><label>Địa chỉ</label><input class="form-control mb-2" name="diaChi" value="@Model.DiaChi" required/><label>Số điện thoại</label><input class="form-control mb-2" name="soDienThoai" value="@Model.SoDienThoai"/><label>Email</label><input class="form-control mb-2" name="email" value="@Model.Email"/><label>Mô tả</label><textarea class="form-control mb-2" name="moTa">@Model.MoTa</textarea><label>Trạng thái</label><select class="form-select mb-3" name="trangThai"><option value="HOAT_DONG" selected="@(Model.TrangThai=="HOAT_DONG")">Hoạt động</option><option value="NGUNG_HOAT_DONG" selected="@(Model.TrangThai=="NGUNG_HOAT_DONG")">Ngừng hoạt động</option></select><button class="btn btn-primary">Lưu</button></form>