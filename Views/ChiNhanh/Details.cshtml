@model RentalCamera.Models.CuaHang
@{ViewData["Title"]="Thiết bị chi nhánh";var devices=ViewBag.Devices as List<RentalCamera.Models.ThietBi> ?? new();var models=ViewBag.Models as List<RentalCamera.Models.DongMay> ?? new();var images=ViewBag.Images as Dictionary<string,string> ?? new();}
<div class="page-head"><div><h1>@Model.TenCuaHang</h1><p>@Model.DiaChi · @Model.SoDienThoai</p></div><a asp-action="Edit" asp-route-id="@Model.MaCuaHang" class="btn btn-primary">Sửa chi nhánh</a></div>
<div class="panel p-3"><h3>Thiết bị tại chi nhánh (@devices.Count)</h3><form method="get" class="row g-2 mb-3"><input type="hidden" name="id" value="@Model.MaCuaHang"/><div class="col-md-4"><input class="form-control" name="q" value="@ViewBag.Q" placeholder="Mã / serial / tên dòng máy"/></div><div class="col-md-3"><select class="form-select" name="dongMay"><option value="">Tất cả dòng máy</option>@foreach(var m in models){<option value="@m.MaDongMay" selected="@(ViewBag.DongMay==m.MaDongMay)">@m.TenDongMay</option>}</select></div><div class="col-md-3"><select class="form-select" name="status"><option value="">Mọi trạng thái</option>@foreach(var state in new[]{"SAN_SANG","DANG_GIU","DANG_THUE","BAO_TRI","HONG","NGUNG_KINH_DOANH"}){<option value="@state" selected="@(ViewBag.Status==state)">@state.Replace("_"," ")</option>}</select></div><div class="col-md-2"><button class="btn btn-primary w-100">Lọc</button></div></form>
<div class="row g-3">@foreach(var d in devices){<div class="col-sm-6 col-lg-4"><div class="card h-100 overflow-hidden">@if(images.TryGetValue(d.MaDongMay,out var url)){<img src="@url" alt="@d.DongMay?.TenDongMay" style="height:180px;object-fit:cover;width:100%"/>}<div class="card-body"><h5>@d.DongMay?.TenDongMay</h5><p>Serial: @d.SoSerial</p><p>Giá: @d.DongMay?.GiaThueNgay.ToString("N0") đ/ngày</p><p>Trạng thái: <b>@d.TrangThai.Replace("_"," ")</b></p><a asp-controller="ThietBi" asp-action="Details" asp-route-id="@d.MaThietBi" class="btn btn-outline-primary">Chi tiết</a></div></div></div>}@if(!devices.Any()){<p>Không có thiết bị phù hợp.</p>}</div></div>