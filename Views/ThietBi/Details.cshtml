@model RentalCamera.Models.ThietBi
@using RentalCamera.Models

@{
    ViewData["Title"] = "Chi tiết thiết bị";

    var lich = ViewBag.Lich as IEnumerable<HopDong> ?? Enumerable.Empty<HopDong>();
    var photos = ViewBag.Anh as List<string> ?? new List<string>();

    var tenMay = Model.DongMay?.TenDongMay ?? "Thiết bị";
    var thuongHieu = Model.DongMay?.ThuongHieu?.TenThuongHieu ?? "Chưa cập nhật";

    string StatusLabel(string? status) => status switch
    {
        "SAN_SANG" => "Sẵn sàng",
        "DANG_GIU" => "Đang giữ",
        "DANG_THUE" => "Đang thuê",
        "BAO_TRI" => "Bảo trì",
        "HONG" => "Hỏng",
        "NGUNG_KINH_DOANH" => "Ngừng kinh doanh",
        _ => status?.Replace("_", " ") ?? "Chưa xác định"
    };

    string StatusClass(string? status) => status switch
    {
        "SAN_SANG" => "available",
        "DANG_THUE" => "renting",
        "DANG_GIU" => "reserved",
        "BAO_TRI" => "maintenance",
        "HONG" => "broken",
        _ => "inactive"
    };

    var giaThue = Model.DongMay?.GiaThueNgay ?? 0;
    var tienCoc = Model.DongMay?.TienCoc ?? 0;
    var giamGia = Model.DongMay?.PhanTramGiamGia ?? 0;
}

<div class="device-details-page">

    <!-- HEADER -->
    <div class="device-details-header">

        <div>
            <div class="device-details-eyebrow">
                <i class="bi bi-camera"></i>
                QUẢN LÝ THIẾT BỊ
            </div>

            <h1>@tenMay</h1>

            <div class="device-details-meta">
                <span>
                    <i class="bi bi-upc-scan"></i>
                    @Model.MaThietBi
                </span>

                <span>
                    <i class="bi bi-hdd"></i>
                    Serial: @Model.SoSerial
                </span>

                <span class="device-status @StatusClass(Model.TrangThai)">
                    <i class="bi bi-circle-fill"></i>
                    @StatusLabel(Model.TrangThai)
                </span>
            </div>
        </div>

        <div class="device-details-actions">

            <a asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left"></i>
                Danh sách
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.MaThietBi"
               class="btn btn-primary">
                <i class="bi bi-pencil-square"></i>
                Chỉnh sửa
            </a>

        </div>

    </div>

    <!-- MAIN GRID -->
    <div class="device-main-grid">

        <!-- LEFT COLUMN -->
        <div class="device-left-column">

            <!-- IMAGE GALLERY -->
            <section class="device-card">

                <div class="device-card-heading">
                    <div>
                        <h3>
                            <i class="bi bi-images"></i>
                            Hình ảnh thiết bị
                        </h3>
                        <p>Thư viện hình ảnh của dòng máy</p>
                    </div>

                    <span class="device-image-count">
                        @photos.Count ảnh
                    </span>
                </div>

                @if (photos.Any())
                {
                    <div class="device-gallery-main">
                        <img id="deviceMainImage"
                             src="@photos[0]"
                             alt="@tenMay" />
                    </div>

                    @if (photos.Count > 1)
                    {
                        <div class="device-gallery-thumbs">

                            @for (int i = 0; i < photos.Count; i++)
                            {
                                <button type="button"
                                        class="device-thumb @(i == 0 ? "active" : "")"
                                        data-image="@photos[i]"
                                        aria-label="Xem ảnh @(i + 1)"
                                        aria-pressed="@(i == 0 ? "true" : "false")">

                                    <img src="@photos[i]"
                                         alt="Ảnh @(i + 1)" />

                                </button>
                            }

                        </div>
                    }
                }
                else
                {
                    <div class="device-gallery-empty">
                        <i class="bi bi-camera"></i>
                        <h4>Chưa có hình ảnh</h4>
                        <p>Hãy thêm ảnh trong trang chỉnh sửa thiết bị.</p>
                    </div>
                }

            </section>

            <!-- DEVICE INFORMATION -->
            <section class="device-card">

                <div class="device-card-heading">
                    <div>
                        <h3>
                            <i class="bi bi-info-circle"></i>
                            Thông tin thiết bị
                        </h3>
                        <p>Thông tin nhận diện và tình trạng thiết bị</p>
                    </div>
                </div>

                <div class="device-info-grid">

                    <div class="device-info-item">
                        <span>Thương hiệu</span>
                        <strong>@thuongHieu</strong>
                    </div>

                    <div class="device-info-item">
                        <span>Dòng máy</span>
                        <strong>@tenMay</strong>
                    </div>

                    <div class="device-info-item">
                        <span>Mã dòng máy</span>
                        <strong>@Model.MaDongMay</strong>
                    </div>

                    <div class="device-info-item">
                        <span>Số serial</span>
                        <strong>@Model.SoSerial</strong>
                    </div>

                    <div class="device-info-item">
                        <span>Tình trạng</span>
                        <strong>@StatusLabel(Model.TinhTrang)</strong>
                    </div>

                    <div class="device-info-item">
                        <span>Ngày nhập</span>
                        <strong>
                            @(Model.NgayNhap?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")
                        </strong>
                    </div>

                </div>

                <div class="device-description">
                    <span>Mô tả dòng máy</span>
                    <p>
                        @(string.IsNullOrWhiteSpace(Model.DongMay?.MoTa)
                            ? "Chưa có mô tả cho dòng máy này."
                            : Model.DongMay.MoTa)
                    </p>
                </div>

            </section>

        </div>

        <!-- RIGHT COLUMN -->
        <div class="device-right-column">

            <!-- PRICING -->
            <section class="device-card device-pricing-card">

                <div class="device-card-heading">
                    <h3>
                        <i class="bi bi-cash-stack"></i>
                        Thông tin giá thuê
                    </h3>
                </div>

                <div class="device-price-label">
                    Giá thuê mỗi ngày
                </div>

                <div class="device-price-main">
                    @giaThue.ToString("N0")
                    <span>đ/ngày</span>
                </div>

                <div class="device-price-divider"></div>

                <div class="device-price-row">
                    <span>
                        <i class="bi bi-wallet2"></i>
                        Tiền cọc
                    </span>

                    <strong>@tienCoc.ToString("N0") đ</strong>
                </div>

                <div class="device-price-row">
                    <span>
                        <i class="bi bi-percent"></i>
                        Giảm giá
                    </span>

                    <strong class="device-discount">
                        @giamGia.ToString("0.##")%
                    </strong>
                </div>

                <a asp-action="Edit"
                   asp-route-id="@Model.MaThietBi"
                   class="btn btn-primary w-100 mt-3">
                    <i class="bi bi-pencil"></i>
                    Chỉnh sửa thông tin
                </a>

                <small class="device-price-note">
                    Giá thuê và tiền cọc được quản lý theo dòng máy.
                </small>

            </section>

            <!-- BRANCH -->
            <section class="device-card">

                <div class="device-card-heading">
                    <h3>
                        <i class="bi bi-shop"></i>
                        Chi nhánh quản lý
                    </h3>
                </div>

                <div class="device-branch">

                    <div class="device-branch-icon">
                        <i class="bi bi-geo-alt"></i>
                    </div>

                    <div>
                        <strong>
                            @(Model.CuaHang?.TenCuaHang ?? "Chưa xác định")
                        </strong>

                        <p>
                            @(Model.CuaHang?.DiaChi ?? "Chưa cập nhật địa chỉ")
                        </p>

                        <small>Mã chi nhánh: @Model.MaCuaHang</small>
                    </div>

                </div>

            </section>

            <!-- RENTAL HISTORY -->
            <section class="device-card">

                <div class="device-card-heading">
                    <div>
                        <h3>
                            <i class="bi bi-clock-history"></i>
                            Lịch thuê gần đây
                        </h3>

                        <p>Các hợp đồng liên quan đến thiết bị</p>
                    </div>
                </div>

                @if (!lich.Any())
                {
                    <div class="device-rental-empty">
                        <i class="bi bi-calendar2-check"></i>
                        <h4>Chưa có lịch thuê</h4>
                        <p>Thiết bị chưa có hợp đồng thuê được ghi nhận.</p>
                    </div>
                }
                else
                {
                    <div class="device-rental-list">

                        @foreach (var h in lich)
                        {
                            <div class="device-rental-item">

                                <div class="device-rental-dot"></div>

                                <div class="device-rental-content">

                                    <div class="device-rental-top">
                                        <strong>@h.MaHopDong</strong>

                                        <span class="device-status @StatusClass(h.TrangThai)">
                                            @StatusLabel(h.TrangThai)
                                        </span>
                                    </div>

                                    <div class="device-rental-date">
                                        <i class="bi bi-calendar-event"></i>
                                        @h.ThoiGianBanGiao.ToString("dd/MM/yyyy HH:mm")
                                    </div>

                                    <div class="device-rental-date">
                                        <i class="bi bi-arrow-return-left"></i>
                                        @h.ThoiGianTraDuKien.ToString("dd/MM/yyyy HH:mm")
                                    </div>

                                    <a asp-controller="DonThue"
                                       asp-action="Details"
                                       asp-route-id="@h.MaHopDong"
                                       class="device-rental-link">
                                        Xem hợp đồng
                                        <i class="bi bi-arrow-right"></i>
                                    </a>

                                </div>

                            </div>
                        }

                    </div>
                }

            </section>

        </div>

    </div>

    <!-- DELETE -->
    <section class="device-delete-section">

        <div>
            <h4>
                <i class="bi bi-shield-exclamation"></i>
                Quản lý thiết bị
            </h4>

            <p>
                Thiết bị đã phát sinh hợp đồng sẽ không được phép xóa.
            </p>
        </div>

        <form method="post"
              asp-action="Delete"
              onsubmit="return confirm('Bạn chắc chắn muốn xóa thiết bị này?')">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.MaThietBi" />

            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash"></i>
                Xóa thiết bị
            </button>

        </form>

    </section>

</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const mainImage = document.getElementById("deviceMainImage");
    const thumbnails = document.querySelectorAll(".device-thumb");

    if (!mainImage) return;

    thumbnails.forEach(function (button) {
        button.addEventListener("click", function () {
            const imageUrl = button.dataset.image;

            if (!imageUrl) return;

            mainImage.src = imageUrl;

            thumbnails.forEach(function (thumb) {
                thumb.classList.remove("active");
                thumb.setAttribute("aria-pressed", "false");
            });

            button.classList.add("active");
            button.setAttribute("aria-pressed", "true");
        });
    });
});
</script>