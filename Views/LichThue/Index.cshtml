@model AvailabilityVM
@{
 ViewData["Title"]="Lịch đặt thiết bị";
 var start=Model.TuNgay.Date.AddDays(-(((int)Model.TuNgay.DayOfWeek+6)%7));
 var days=Enumerable.Range(0,7).Select(i=>start.AddDays(i)).ToArray();
 var previous=start.AddDays(-7); var next=start.AddDays(7);
 var dayNames=new[]{"Thứ 2","Thứ 3","Thứ 4","Thứ 5","Thứ 6","Thứ 7","Chủ nhật"};
}
<div class="page-head sl-single-head"><div><h1>Lịch đặt thiết bị</h1><p>Theo dõi hợp đồng theo tuần và kiểm tra thiết bị trống theo thời gian thuê</p></div><div class="sl-calendar-controls"><a class="btn btn-outline-primary" asp-action="Index" asp-route-tuNgay="@previous.ToString("yyyy-MM-dd")" asp-route-denNgay="@previous.AddDays(7).ToString("yyyy-MM-dd")" asp-route-q="@Model.Q" aria-label="Tuần trước"><i class="bi bi-chevron-left"></i></a><span class="sl-week-label">@start.ToString("dd/MM") – @start.AddDays(6).ToString("dd/MM/yyyy")</span><a class="btn btn-outline-primary" asp-action="Index" asp-route-tuNgay="@next.ToString("yyyy-MM-dd")" asp-route-denNgay="@next.AddDays(7).ToString("yyyy-MM-dd")" asp-route-q="@Model.Q" aria-label="Tuần sau"><i class="bi bi-chevron-right"></i></a></div></div>
<section class="panel mb-3 sl-calendar-card"><div class="sl-week-grid">
@for(var i=0;i<7;i++) { var date=days[i];var entries=Model.HopDong.Where(x=>x.ThoiGianBanGiao.Date<=date && x.ThoiGianTraDuKien.Date>=date && x.TrangThai!="DA_HUY").ToList();
 <div class="sl-week-day"><div class="sl-week-day-header"><b>@dayNames[i]</b><small>@date.ToString("dd/MM")</small></div>
 @if(entries.Count==0){<div class="sl-week-empty">Trống lịch</div>}
 @foreach(var h in entries){<a class="sl-calendar-event" asp-controller="DonThue" asp-action="Details" asp-route-id="@h.MaHopDong"><strong>@h.MaHopDong</strong><span>@h.KhachThue?.HoTen</span><small>@h.ThoiGianBanGiao.ToString("dd/MM") → @h.ThoiGianTraDuKien.ToString("dd/MM")</small></a>}
 </div>}
</div><p class="small text-muted mb-0 mt-3">Lịch hiển thị theo khoảng bàn giao và trả dự kiến của hợp đồng hiện có. Chọn một hợp đồng để xem chi tiết.</p></section>
<section class="panel mb-3"><div class="panel-title"><div><h3>Kiểm tra thiết bị còn trống</h3><p class="muted mb-0">Kiểm tra serial trước khi phân bổ vào hợp đồng</p></div></div><form class="row g-3 align-items-end mt-1"><div class="col-md-3"><label class="form-label" for="from">Từ ngày/giờ</label><input id="from" type="datetime-local" name="tuNgay" value="@Model.TuNgay.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required></div><div class="col-md-3"><label class="form-label" for="to">Đến ngày/giờ</label><input id="to" type="datetime-local" name="denNgay" value="@Model.DenNgay.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required></div><div class="col-md-4"><label class="form-label" for="device-search">Tìm dòng máy / serial</label><input id="device-search" name="q" value="@Model.Q" class="form-control" placeholder="Canon EOS R6, CR6-0001..."></div><div class="col-md-2"><button class="btn btn-primary w-100"><i class="bi bi-search"></i> Kiểm tra</button></div></form><div class="table-responsive mt-3"><table class="table align-middle"><thead><tr><th>Thiết bị</th><th>Serial</th><th>Dòng máy</th><th>Tình trạng</th><th>Khả dụng</th></tr></thead><tbody>
@foreach(var x in Model.ThietBi){var busy=Model.MaThietBiBan.Contains(x.MaThietBi);var blocked=x.TrangThai=="BAO_TRI"||x.TrangThai=="HONG"||x.TrangThai=="NGUNG_KINH_DOANH";<tr><td><a asp-controller="ThietBi" asp-action="Details" asp-route-id="@x.MaThietBi">@x.MaThietBi</a></td><td>@x.SoSerial</td><td>@x.DongMay?.TenDongMay</td><td>@x.TinhTrang.Replace("_"," ")</td><td>@if(busy){<span class="badge bg-danger">Trùng lịch</span>}else if(blocked){<span class="badge bg-warning text-dark">Không khả dụng</span>}else{<span class="badge bg-success">Có thể thuê</span>}</td></tr>}
@if(!Model.ThietBi.Any()){<tr><td colspan="5" class="text-center text-muted py-4">Không tìm thấy thiết bị phù hợp.</td></tr>}
</tbody></table></div></section>
