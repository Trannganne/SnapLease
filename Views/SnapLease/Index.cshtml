@{ ViewData["Title"] = "Trung tâm nghiệp vụ"; }
<div class="sl-admin">
  <div class="sl-admin-hero">
    <div><div class="sl-eyebrow"><i class="bi bi-grid-1x2-fill"></i> SNAPLEASE / VẬN HÀNH CỬA HÀNG</div>
      <h1>Trung tâm nghiệp vụ</h1><p>Quản lý toàn bộ quy trình thuê máy ảnh trên một màn hình làm việc.</p></div>
    <div class="sl-hero-side"><span class="sl-api-indicator"><span class="sl-dot"></span> Backend API · localhost:5000</span><small>Không sử dụng dữ liệu mẫu cho giao dịch</small></div>
  </div>
  <div class="sl-stats">
    <div class="sl-stat"><div class="sl-stat-icon blue"><i class="bi bi-wallet2"></i></div><div><span>Tiền cọc</span><strong>Xác nhận thu</strong><small>Giao dịch tiền mặt</small></div></div>
    <div class="sl-stat"><div class="sl-stat-icon violet"><i class="bi bi-camera"></i></div><div><span>Thiết bị</span><strong>Phân bổ serial</strong><small>Kiểm tra khả dụng</small></div></div>
    <div class="sl-stat"><div class="sl-stat-icon orange"><i class="bi bi-file-earmark-check"></i></div><div><span>Hợp đồng</span><strong>Bàn giao / Nhận lại</strong><small>Theo dõi trạng thái</small></div></div>
    <div class="sl-stat"><div class="sl-stat-icon green"><i class="bi bi-images"></i></div><div><span>Biên bản</span><strong>Ảnh tình trạng</strong><small>Ghi nhận chứng từ</small></div></div>
  </div>
  <div class="sl-workspace" id="sl-app" data-mode="tiencoc" data-fetch="@Url.Action("Fetch", "SnapLease")" data-send="@Url.Action("Send", "SnapLease")">
    @Html.AntiForgeryToken()
    <div class="sl-workspace-head"><div><h2>Không gian làm việc</h2><p>Chọn nghiệp vụ để thao tác trên hợp đồng thực tế</p></div><span class="sl-workspace-tag"><i class="bi bi-shield-check"></i> Giao dịch có xác nhận</span></div>
    <div class="sl-tabs" role="tablist" aria-label="Chức năng nghiệp vụ">
      <button class="sl-tab is-active" type="button" data-tab="tiencoc" role="tab" aria-selected="true"><i class="bi bi-cash-stack"></i><span>Tiền cọc</span></button>
      <button class="sl-tab" type="button" data-tab="phanbo" role="tab" aria-selected="false"><i class="bi bi-camera"></i><span>Phân bổ thiết bị</span></button>
      <button class="sl-tab" type="button" data-tab="hopdong" role="tab" aria-selected="false"><i class="bi bi-file-earmark-text"></i><span>Hợp đồng</span></button>
      <button class="sl-tab" type="button" data-tab="hinhanh" role="tab" aria-selected="false"><i class="bi bi-card-image"></i><span>Ảnh tình trạng</span></button>
    </div>
    <div class="sl-workspace-body">
      <div class="sl-section-title"><div class="sl-step">01</div><div><h3 id="sl-mode-title">Xác nhận tiền cọc</h3><p id="sl-mode-description">Tra cứu khoản cọc và xác nhận đã nhận tiền mặt</p></div></div>
      <div class="alert alert-light border d-flex align-items-center justify-content-between flex-wrap gap-2"><span><i class="bi bi-file-earmark-pdf"></i> Xuất hợp đồng theo mã đang nhập (dữ liệu từ API)</span><button class="btn btn-outline-primary" type="button" id="sl-export-pdf"><i class="bi bi-printer"></i> In / Lưu PDF</button></div>
      <div class="sl-search-box"><label for="sl-id">Mã hợp đồng</label><div class="sl-search-row"><div class="sl-search-input"><i class="bi bi-search"></i><input id="sl-id" class="form-control" autocomplete="off" placeholder="Nhập mã hợp đồng từ Backend..." /></div><button class="btn sl-primary-btn" type="button" id="sl-load"><i class="bi bi-arrow-clockwise"></i> Tải thông tin</button></div><small>Đăng nhập tài khoản nhân viên trước khi tra cứu. Mọi thao tác ghi dữ liệu thật vào API.</small></div>
      <div class="sl-empty-state" id="sl-empty"><div class="sl-empty-icon"><i class="bi bi-clipboard2-data"></i></div><h4>Chưa có hợp đồng được chọn</h4><p>Nhập mã hợp đồng và nhấn <b>Tải thông tin</b> để bắt đầu xử lý nghiệp vụ.</p></div>
      <div id="sl-result" class="sl-panel sl-data-panel" hidden><div class="sl-section-title"><div class="sl-step">02</div><div><h3>Thông tin hợp đồng</h3><p>Dữ liệu được lấy trực tiếp từ Backend</p></div></div><div id="sl-summary"></div><details class="sl-raw"><summary><i class="bi bi-code-slash"></i> Xem dữ liệu JSON gốc</summary><pre id="sl-json" class="sl-json"></pre></details></div>
      <div id="sl-actions" class="sl-panel sl-data-panel" hidden><div class="sl-section-title"><div class="sl-step">03</div><div><h3>Thực hiện nghiệp vụ</h3><p>Kiểm tra kỹ dữ liệu trước khi xác nhận</p></div></div><div id="sl-controls"></div><div id="sl-feedback" role="status" aria-live="polite" class="mt-3"></div></div>
    </div>
  </div>
  <div class="sl-admin-foot"><i class="bi bi-info-circle"></i> Chức năng ảnh hiện lưu URL hình ảnh; tải file ảnh trực tiếp cần API upload riêng. Các thao tác hợp đồng phải đúng trạng thái do Backend quy định.</div>
</div>
<script>
document.getElementById('sl-export-pdf')?.addEventListener('click', function () {
  const id = document.getElementById('sl-id')?.value?.trim();
  if (!id) { alert('Vui lòng nhập mã hợp đồng trước khi xuất PDF.'); return; }
  window.open('@Url.Action("Index", "HopDongPdf")?id=' + encodeURIComponent(id), '_blank', 'noopener');
});
</script>
@section Scripts { <script src="~/js/snaplease.js" asp-append-version="true"></script> }
