@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string name) => controller.Equals(name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var displayName = Context.Session.GetString("User") ?? "Nhân viên";
    var role = Context.Session.GetString("Role") ?? "";
}
<aside class="sidebar" id="sl-sidebar" aria-label="Điều hướng chính">
    <a class="brand" asp-controller="Home" asp-action="Index" title="Trang tổng quan SnapLease">
        <span class="brand-icon"><i class="bi bi-camera-fill" aria-hidden="true"></i></span>
        <span><b>SnapLease</b><small>CAMPRO · QUẢN LÝ CHO THUÊ</small></span>
    </a>
    <div class="sl-sidebar-scroll">
        <div class="sl-nav-caption">KHÔNG GIAN LÀM VIỆC</div>
        <div class="nav-label">TỔNG QUAN</div>
        <nav aria-label="Tổng quan">
            <a title="Tổng quan" class="@Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2" aria-hidden="true"></i><span>Tổng quan</span></a>
        </nav>
        <div class="nav-label">VẬN HÀNH</div>
        <nav aria-label="Vận hành">
            <a title="Đơn thuê & hợp đồng" class="@Active("DonThue")" asp-controller="DonThue" asp-action="Index"><i class="bi bi-receipt" aria-hidden="true"></i><span>Đơn thuê & hợp đồng</span></a>
            <a title="Lịch đặt thiết bị" class="@Active("LichThue")" asp-controller="LichThue" asp-action="Index"><i class="bi bi-calendar3" aria-hidden="true"></i><span>Lịch đặt thiết bị</span></a>
        </nav>
        <div class="nav-label">TÀI SẢN</div>
        <nav aria-label="Tài sản">
            @if (Context.Session.GetString("Role")
        is "ADMIN" or "NHAN_VIEN")
            {
                <a title="Thiết bị"
                class="@Active("ThietBi")"
                asp-controller="ThietBi"
                asp-action="Index">
                    <i class="bi bi-camera"></i>
                    <span>Thiết bị</span>
                </a>
            }
            <a title="Bảo trì" class="@Active("BaoTri")" asp-controller="BaoTri" asp-action="Index"><i class="bi bi-tools" aria-hidden="true"></i><span>Bảo trì & sửa chữa</span></a>
            <a title="Phí phạt" class="@Active("PhiPhat")" asp-controller="PhiPhat" asp-action="Index"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><span>Phí phạt</span></a>
        </nav>
        <div class="nav-label">KHÁCH HÀNG & PHÂN TÍCH</div>
        <nav aria-label="Khách hàng và phân tích">
            <a title="Khách hàng" class="@Active("KhachHang")" asp-controller="KhachHang" asp-action="Index"><i class="bi bi-people" aria-hidden="true"></i><span>Khách hàng</span></a>
            <a title="Báo cáo" class="@Active("BaoCao")" asp-controller="BaoCao" asp-action="Index"><i class="bi bi-bar-chart-line" aria-hidden="true"></i><span>Báo cáo thống kê</span></a>
        </nav>
        <div class="nav-label">QUẢN TRỊ HỆ THỐNG</div>
        <nav aria-label="Quản trị hệ thống">
            <a title="Chi nhánh" class="@Active("ChiNhanh")" asp-controller="ChiNhanh" asp-action="Index"><i class="bi bi-shop" aria-hidden="true"></i><span>Chi nhánh</span></a>
            @if (Context.Session.GetString("Role") == "ADMIN")
        {
            <a title="Nhân viên"
            class="@Active("NhanVien")"
            asp-controller="NhanVien"
            asp-action="Index">
                <i class="bi bi-person-badge"></i>
                <span>Nhân viên & phân quyền</span>
            </a>
        }
        </nav>
        <div class="nav-label">HỆ THỐNG</div>
        <nav aria-label="Hệ thống">
            <a title="Cài đặt" class="@Active("CaiDat")" asp-controller="CaiDat" asp-action="Index"><i class="bi bi-gear" aria-hidden="true"></i><span>Cài đặt & hồ sơ</span></a>
        </nav>
    </div>
    <div class="sl-sidebar-footer-label">TÀI KHOẢN ĐANG SỬ DỤNG</div>
    <div class="sidebar-bottom sl-sidebar-profile">
        <span class="sl-sidebar-avatar" aria-hidden="true"><i class="bi bi-person"></i></span>
        <span class="sl-sidebar-profile-copy"><strong>@displayName</strong><small>@(string.IsNullOrWhiteSpace(role) ? "Tài khoản SnapLease" : role)</small></span>
        <a class="sl-sidebar-logout" title="Đăng xuất" aria-label="Đăng xuất" asp-controller="Auth" asp-action="Logout"><i class="bi bi-box-arrow-right"></i></a>
    </div>
</aside>
