<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>@ViewData["Title"] - SNAPLEASE</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Google Font Roboto -->
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap">

    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/snaplease.css" asp-append-version="true" />
    <!-- CSS của website -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/snaplease-admin.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/geekblue-design-system.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/admin-polish.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pages/contract-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/management-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/snaplease-redesign-2026.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/snaplease-final-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/snaplease-ux-fixes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/dashboard-reference-effects.css" asp-append-version="true" />
    <!-- Dashboard styles were missing: without them cards and charts stack as plain blocks. -->
    <link rel="stylesheet" href="~/css/pages/dashboard-modern.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/dashboard-kpi-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/orders-branches.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/unified-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/snaplease-layout-repair.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar-refresh.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/snaplease-page-photo-banner.css" asp-append-version="true" />
</head>

<body>

    <div class="sl-app-backdrop" id="sl-app-backdrop" aria-hidden="true"></div>
    <div class="app-shell">

        <!-- Sidebar -->
        <partial name="_Sidebar" />

        <!-- Nội dung chính -->
        <main class="main">

            <!-- Header -->
            <partial name="_Header" />

            <section class="content">
                <nav class="sl-breadcrumb sl-compact-crumb" aria-label="Đường dẫn trang"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Trang chủ</a><i class="bi bi-chevron-right"></i><span>@ViewData["Title"]</span></nav>

                @if (TempData["Ok"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="status">
                        @TempData["Ok"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                    </div>
                }

                @{
                    var bannerController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
                    var bannerTitle = ViewData["Title"]?.ToString() ?? "Quản lý";
                    var bannerDescription = bannerController switch
                    {
                        "Home" => "Theo dõi thiết bị, hợp đồng và hiệu quả vận hành tại một nơi.",
                        "LichThue" => "Theo dõi lịch đặt thiết bị, bàn giao và hoàn trả theo thời gian.",
                        "DonThue" => "Quản lý hợp đồng thuê và tiến độ thực hiện.",
                        "ThietBi" => "Theo dõi tình trạng, lịch sử và danh sách thiết bị.",
                        "BaoTri" => "Theo dõi công việc bảo trì và tình trạng thiết bị.",
                        "PhiPhat" => "Quản lý các khoản phí phạt và xử lý phát sinh.",
                        "KhachHang" => "Tra cứu khách hàng và thông tin thuê thiết bị.",
                        "BaoCao" => "Theo dõi số liệu và hiệu quả hoạt động.",
                        "ChiNhanh" => "Quản lý thông tin chi nhánh và thiết bị tại cửa hàng.",
                        "NhanVien" => "Quản lý nhân viên và phân quyền truy cập.",
                        _ => "Quản lý và theo dõi thông tin trong hệ thống SnapLease."
                    };
                }
                @if (bannerController != "Auth")
                {
                    <section class="sl-page-photo-banner @(bannerController == "Home" ? "sl-dashboard-banner" : "")" aria-label="Tiêu đề trang">
                        <div class="sl-page-photo-banner__content">
                            <span class="sl-page-photo-banner__eyebrow"><i class="bi bi-camera" aria-hidden="true"></i> SNAPLEASE · QUẢN TRỊ VẬN HÀNH</span>
                            <h1>@bannerTitle</h1>
                            <p>@bannerDescription</p>
                        </div>
                    </section>
                }

                @RenderBody()
                <footer class="sl-app-footer"><span>SnapLease Admin · CAMPRO</span><span><i class="bi bi-shield-check" aria-hidden="true"></i> Thao tác được xử lý theo quyền tài khoản</span></footer>

            </section>

        </main>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- JS của website -->
    <script src="~/js/admin-shell.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/geekblue-components.js" asp-append-version="true" defer></script>

    <script src="~/js/dashboard-page-transitions.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>