@{ ViewData["Title"] = "Thư viện giao diện Geek Blue"; }
<div class="container-fluid" class="sl-components-container">
<header class="mb-4"><div class="sl-badge sl-badge-info mb-2">CHỈ MÔI TRƯỜNG DEVELOPMENT</div><h1>Thư viện giao diện · Geek Blue</h1><p class="sl-demo-muted">Roboto · Design tokens · Bootstrap 5 + Razor · Bảng màu và các trạng thái cơ bản</p></header>
<section class="sl-demo-section"><h2>01 · Bảng màu Geek Blue</h2><div class="sl-demo-grid">@for(var i=1;i<=10;i++){var hex=new[]{"#f0f5ff","#d6e4ff","#adc6ff","#85a5ff","#597ef7","#2f54eb","#1d39c4","#10239e","#061178","#030852"}[i-1];<div class="sl-token" class="sl-token-color-@i"><span>geekblue-@i</span><span>@hex</span></div>}</div></section>
<section class="sl-demo-section"><h2>02 · Typography Roboto</h2><h1>Tiêu đề trang H1 · 32px</h1><h2>Tiêu đề khu vực H2</h2><h3>Tiêu đề thẻ H3</h3><p>Quản lý cho thuê máy ảnh · Tiếng Việt có dấu · 1.285.000đ · 14/10/2026</p><small class="sl-demo-muted">Nội dung phụ · Trạng thái và chú thích</small></section>
<section class="sl-demo-section"><h2>03 · Nút bấm</h2><div class="sl-demo-row"><button class="sl-btn sl-btn-primary" data-sl-toast="Đã nhấn nút chính">Primary</button><button class="sl-btn sl-btn-secondary">Secondary</button><button class="sl-btn sl-btn-ghost">Ghost</button><button class="sl-btn sl-btn-danger">Danger</button><button class="sl-btn sl-btn-link">Link</button><button class="sl-btn sl-btn-primary sl-btn-sm">Small</button><button class="sl-btn sl-btn-primary sl-btn-lg">Large</button><button class="sl-btn sl-btn-primary sl-btn-icon" aria-label="Thêm mới"><i class="bi bi-plus-lg"></i></button><button class="sl-btn sl-btn-primary" disabled>Disabled</button><button class="sl-btn sl-btn-primary" aria-busy="true"><span class="sl-spinner" aria-hidden="true"></span> Đang lưu</button></div></section>
<section class="sl-demo-section"><h2>04 · Form controls</h2><div class="row g-3"><div class="col-lg-4"><label class="form-label" for="demo-search">Tìm kiếm <span class="sl-required">*</span></label><div class="input-group"><input id="demo-search" class="form-control" placeholder="Tên, SKU, thương hiệu"/><button class="btn btn-outline-primary" data-sl-clear="demo-search" type="button">Xóa</button></div><div class="sl-help">Nhập từ khóa để thử kiểu nhập liệu</div></div><div class="col-lg-4"><label class="form-label" for="demo-select">Trạng thái</label><select class="form-select" id="demo-select"><option>Tất cả</option><option>Sẵn sàng</option><option>Đang thuê</option><option>Bảo trì</option></select></div><div class="col-lg-4"><label class="form-label" for="demo-date">Ngày</label><input class="form-control" type="date" id="demo-date"/></div><div class="col-lg-4"><label class="form-label" for="demo-error">Trường lỗi</label><input id="demo-error" class="form-control is-invalid" aria-describedby="demo-error-msg" value="Sai định dạng"/><div class="invalid-feedback d-block" id="demo-error-msg">Vui lòng kiểm tra dữ liệu</div></div><div class="col-lg-4"><label class="form-label" for="demo-notes">Ghi chú</label><textarea id="demo-notes" class="form-control" rows="2"></textarea></div><div class="col-lg-4"><label class="form-label" for="demo-disabled">Đã khóa</label><input id="demo-disabled" class="form-control" value="Không chỉnh sửa" disabled/></div></div><div class="sl-demo-row mt-3"><label><input type="checkbox" checked/> Gửi thông báo</label><label><input type="radio" name="demo-radio" checked/> Tuần</label><label><input type="radio" name="demo-radio"/> Tháng</label><label class="form-check form-switch"><input class="form-check-input" type="checkbox" role="switch" checked/> Hiển thị</label></div></section>
<section class="sl-demo-section"><h2>05 · Trạng thái & KPI</h2><div class="sl-demo-row mb-3"><span class="sl-badge sl-badge-success">Sẵn sàng</span><span class="sl-badge sl-badge-info">Đang thuê</span><span class="sl-badge sl-badge-warning">Chờ bàn giao</span><span class="sl-badge sl-badge-danger">Hỏng / Đã hủy</span><span class="sl-badge sl-badge-neutral">Bảo trì</span></div><div class="sl-demo-grid"><article class="sl-card p-3"><small>Doanh thu tháng</small><h3 class="mt-2">1.285.000đ</h3><span class="sl-badge sl-badge-success">+12,5% kỳ trước</span></article><article class="sl-card p-3"><small>Thiết bị đang thuê</small><h3 class="mt-2">18</h3><span class="sl-badge sl-badge-info">Đang hoạt động</span></article></div><small class="sl-demo-muted">Dữ liệu ở trang thư viện chỉ dùng minh họa component, không phải dữ liệu Backend.</small></section>
<section class="sl-demo-section"><h2>06 · Bảng, loading, empty state</h2><div class="sl-table-scroll"><table class="table table-hover"><thead><tr><th><input type="checkbox" aria-label="Chọn tất cả"/></th><th>SKU</th><th>Thiết bị</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><tr><td><input type="checkbox" aria-label="Chọn CAM001"/></td><td>CAM001</td><td>Canon EOS R6</td><td><span class="sl-badge sl-badge-success">Sẵn sàng</span></td><td><button class="sl-btn sl-btn-secondary sl-btn-sm">Chi tiết</button></td></tr></tbody></table></div><div class="sl-demo-grid mt-3"><div class="sl-skeleton" class="sl-demo-skeleton" aria-label="Đang tải"></div><div class="sl-empty"><i class="bi bi-inbox fs-3 d-block"></i>Không có dữ liệu</div><div><span class="sl-spinner" role="status" aria-label="Đang tải"></span><div class="sl-progress mt-2"><span class="sl-demo-progress"></span></div></div></div></section>
<section class="sl-demo-section"><h2>07 · Modal, tooltip, toast</h2><div class="sl-demo-row"><button class="sl-btn sl-btn-primary" data-bs-toggle="modal" data-bs-target="#slDemoModal">Mở hộp thoại</button><button class="sl-btn sl-btn-secondary" data-sl-toast="Thông báo giao diện mẫu">Hiện Toast</button><button class="sl-btn sl-btn-ghost" title="Thông tin hỗ trợ">Tooltip</button></div><div class="modal fade" id="slDemoModal" tabindex="-1" aria-labelledby="slModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="slModalTitle">Xác nhận thao tác</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body">Đây là hộp thoại minh họa, không ghi dữ liệu vào Backend.</div><div class="modal-footer"><button class="sl-btn sl-btn-secondary" data-bs-dismiss="modal">Hủy</button><button class="sl-btn sl-btn-primary" data-bs-dismiss="modal" data-sl-toast="Đã xác nhận (demo)">Xác nhận</button></div></div></div></div></section>
<section class="sl-demo-section"><h2>08 · Upload nhiều ảnh (chỉ xem trước)</h2><label class="sl-upload-zone d-block" for="sl-demo-upload"><i class="bi bi-cloud-arrow-up fs-2 d-block"></i>Chọn ảnh để xem trước (JPG, PNG, WebP; tối đa 5 MB/ảnh)</label><input class="visually-hidden" id="sl-demo-upload" type="file" accept="image/jpeg,image/png,image/webp" multiple data-sl-file-preview="sl-demo-preview"/><div id="sl-demo-preview" aria-live="polite"></div><small class="sl-demo-muted">Trang demo không gửi ảnh lên máy chủ.</small></section>
</div>
