@model RentalCamera.Models.PhieuPhat
@{ViewData["Title"]="Lập phiếu phạt";}<div class="page-head"><div><h1>Lập phiếu phạt</h1><p>Ghi nhận vi phạm gắn trực tiếp với thiết bị trong hợp đồng</p></div><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div><div class="panel"><form method="post" class="row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-6"><label>Mã phiếu</label><input asp-for="MaPhieuPhat" class="form-control" readonly></div><div class="col-md-6"><label>Chi tiết hợp đồng / thiết bị</label><select asp-for="MaChiTietHopDong" class="form-select">@foreach(var x in (IEnumerable<RentalCamera.Models.ChiTietHopDong>)ViewBag.ChiTiet){<option value="@x.MaChiTietHopDong">@x.MaHopDong · @x.MaThietBi · @x.MaChiTietHopDong</option>}</select></div><div class="col-md-6"><label>Loại vi phạm</label><select asp-for="LoaiViPham" class="form-select"><option value="TRA_TRE">Trả trễ</option><option value="HU_HONG">Hư hỏng</option><option value="MAT_PHU_KIEN">Mất phụ kiện</option><option value="KHAC">Khác</option></select></div><div class="col-md-6"><label>Số tiền</label><input asp-for="SoTien" type="number" min="0" class="form-control"></div><div class="col-md-6"><label>Ngày lập</label><input asp-for="NgayLap" type="datetime-local" class="form-control"></div><div class="col-md-6"><label>Trạng thái</label><select asp-for="TrangThai" class="form-select"><option value="CHUA_THANH_TOAN">Chưa thanh toán</option><option value="DA_THANH_TOAN">Đã thanh toán</option><option value="HUY">Hủy</option></select></div><div class="col-12"><label>Mô tả</label><textarea asp-for="MoTa" class="form-control" rows="4" placeholder="Mô tả tình trạng vi phạm, cách tính phí..."></textarea></div><div class="col-12"><button class="btn btn-primary">Lưu phiếu phạt</button></div></form></div>
