@model OrderVM
@using RentalCamera.Models
@{
    ViewData["Title"] = "Đơn thuê & hợp đồng";
    var branches = ViewBag.ChiNhanh as List<CuaHang> ?? new List<CuaHang>();
    var names = branches.ToDictionary(x => x.MaCuaHang, x => x.TenCuaHang);
    string BranchName(string code) => names.TryGetValue(code, out var name) ? name : code;
    string Status(string code) => code switch {
        "DANG_THUE" => "Đang thuê", "DA_HOAN_THANH" => "Hoàn thành",
        "CHO_BAN_GIAO" => "Chờ bàn giao", "DANG_CHON" => "Đang chọn",
        "DA_CHUYEN_HOP_DONG" => "Đã chuyển hợp đồng",
        "CHO_XAC_NHAN" => "Chờ xác nhận", _ => code.Replace("_", " ")
    };
}
<div class="page-head">
    <div>
        <h1>Đơn thuê & hợp đồng</h1>
        <p>Theo dõi hợp đồng, phân bổ thiết bị, bàn giao và nhận trả theo chi nhánh</p>
    </div>
</div>
<form method="get" asp-action="Index" class="panel sl-orders-filter">
    <div class="sl-orders-filter-grid">
        <label>Chi nhánh
            <select class="form-select" name="chiNhanh">
                <option value="">Tất cả chi nhánh</option>
                @foreach(var branch in branches) {
                    <option value="@branch.MaCuaHang" selected="@(ViewBag.ChiNhanhDaChon == branch.MaCuaHang)">@branch.TenCuaHang</option>
                }
            </select>
        </label>
        <label>Trạng thái
            <select class="form-select" name="trangThai">
                <option value="">Tất cả trạng thái</option>
                @foreach(var state in new[]{"DANG_THUE","DA_HOAN_THANH","CHO_BAN_GIAO","DANG_CHON","DA_CHUYEN_HOP_DONG","CHO_XAC_NHAN"}) {
                    <option value="@state" selected="@(ViewBag.TrangThaiDaChon == state)">@Status(state)</option>
                }
            </select>
        </label>
        <label>Từ ngày<input class="form-control" type="date" name="tuNgay" value="@ViewBag.TuNgay" /></label>
        <label>Đến ngày<input class="form-control" type="date" name="denNgay" value="@ViewBag.DenNgay" /></label>
        <div class="sl-orders-filter-actions">
            <button class="btn btn-primary" type="submit"><i class="bi bi-funnel"></i> Lọc</button>
            <a class="btn btn-outline-primary" asp-action="Index"><i class="bi bi-arrow-counterclockwise"></i> Đặt lại</a>
        </div>
    </div>
</form>
<section class="panel sl-orders-panel">
    <h3><i class="bi bi-file-earmark-text"></i> Danh sách hợp đồng <span class="sl-orders-count">@Model.HopDong.Count</span></h3>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Mã hợp đồng</th><th>Khách hàng</th><th>Chi nhánh</th><th>Ngày thuê</th><th>Ngày trả</th><th>Tổng tiền</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
            <tbody>
            @foreach(var x in Model.HopDong) {
                <tr>
                    <td><strong>@x.MaHopDong</strong></td>
                    <td>@(x.KhachThue?.HoTen ?? x.MaKhachThue)</td>
                    <td><span class="sl-orders-branch"><i class="bi bi-shop"></i> @BranchName(x.MaCuaHang)</span></td>
                    <td>@x.ThoiGianBanGiao.ToString("dd/MM/yyyy")</td>
                    <td>@x.ThoiGianTraDuKien.ToString("dd/MM/yyyy")</td>
                    <td class="money">@x.TongTien.ToString("N0") đ</td>
                    <td><span class="badge-soft">@Status(x.TrangThai)</span></td>
                    <td><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@x.MaHopDong">Chi tiết <i class="bi bi-arrow-right"></i></a></td>
                </tr>
            }
            @if(Model.HopDong.Count == 0) { <tr><td colspan="8" class="text-center py-4 text-muted">Không có hợp đồng phù hợp bộ lọc.</td></tr> }
            </tbody>
        </table>
    </div>
</section>
<section class="panel sl-orders-panel mt-3">
    <h3><i class="bi bi-hourglass-split"></i> Đơn/giỏ hàng chờ xử lý <span class="sl-orders-count">@Model.GioHang.Count</span></h3>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Mã</th><th>Khách hàng</th><th>Chi nhánh</th><th>Ngày tạo</th><th>Trạng thái</th></tr></thead>
            <tbody>
            @foreach(var x in Model.GioHang) {
                <tr>
                    <td><strong>@x.MaGioHang</strong></td>
                    <td>@(x.KhachThue?.HoTen ?? x.MaKhachThue)</td>
                    <td><span class="sl-orders-branch"><i class="bi bi-shop"></i> @BranchName(x.MaCuaHang)</span></td>
                    <td>@x.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><span class="badge-soft">@Status(x.TrangThai)</span></td>
                </tr>
            }
            @if(Model.GioHang.Count == 0) { <tr><td colspan="5" class="text-center py-4 text-muted">Không có đơn hoặc giỏ hàng phù hợp.</td></tr> }
            </tbody>
        </table>
    </div>
</section>
