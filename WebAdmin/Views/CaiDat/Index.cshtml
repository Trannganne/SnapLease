@model NhanVien?
@{ViewData["Title"]="Thông tin nhân viên";}<div class="page-head"><div><p>Cài đặt › Thông tin nhân viên</p><h1>Thông tin nhân viên</h1><p>Quản lý hồ sơ cá nhân, phân quyền và bảo mật tài khoản</p></div></div><div class="row g-3"><div class="col-lg-4"><div class="panel profile"><div class="profile-avatar">@(Model?.HoTen?.Substring(0,1)??"A")</div><h2>@(Model?.HoTen??"Administrator")</h2><p>@(Model?.ChucVu??"Administrator")</p><hr><div class="cost"><span>Mã nhân viên</span><b>@Model?.MaNhanVien</b></div><div class="cost"><span>Trạng thái</span><b>@Model?.TrangThai</b></div></div></div><div class="col-lg-8"><div class="panel"><h3>Thông tin liên hệ</h3><div class="row g-3"><div class="col-md-6"><label>Họ và tên</label><input class="form-control" value="@Model?.HoTen"></div><div class="col-md-6"><label>Email</label><input class="form-control" value="@Model?.Email"></div><div class="col-md-6"><label>Số điện thoại</label><input class="form-control" value="@Model?.SoDienThoai"></div><div class="col-md-6"><label>Địa chỉ</label><input class="form-control" value="@Model?.DiaChi"></div></div></div></div></div>
