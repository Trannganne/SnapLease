<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>@ViewData["Title"] - SNAPLEASE</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Google Font Roboto -->
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap">

    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/snaplease.css" asp-append-version="true" />
    <!-- CSS của website -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/snaplease-admin.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/geekblue-design-system.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/admin-polish.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pages/unified-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/contract-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/orders-branches.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/management-pages.css" asp-append-version="true" />
</head>

<body>

    <div class="sl-app-backdrop" id="sl-app-backdrop" aria-hidden="true"></div>
    <div class="app-shell">

        <!-- Sidebar -->
        <partial name="_Sidebar" />

        <!-- Nội dung chính -->
        <main class="main">

            <!-- Header -->
            <partial name="_Header" />

            <section class="content">
                <nav class="sl-breadcrumb sl-compact-crumb" aria-label="Đường dẫn trang"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Trang chủ</a><i class="bi bi-chevron-right"></i><span>@ViewData["Title"]</span></nav>

                @if (TempData["Ok"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["Ok"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["Error"]
                    </div>
                }

                @RenderBody()
                <footer class="sl-app-footer"><span>SnapLease Admin · CAMPRO</span><span><i class="bi bi-shield-check" aria-hidden="true"></i> Thao tác được xử lý theo quyền tài khoản</span></footer>

            </section>

        </main>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- JS của website -->
    <script src="~/js/admin-shell.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/geekblue-components.js" asp-append-version="true" defer></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>