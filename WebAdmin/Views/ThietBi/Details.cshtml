@model RentalCamera.Models.ThietBi
@{ViewData["Title"]="Chi tiết thiết bị";var lich=(IEnumerable<RentalCamera.Models.HopDong>)ViewBag.Lich;}<div class="page-head"><div><h1>@Model.DongMay?.TenDongMay</h1><p>@Model.MaThietBi · Serial @Model.SoSerial</p></div><div class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@Model.MaThietBi" class="btn btn-primary">Chỉnh sửa</a><a asp-action="Index" class="btn btn-outline-secondary">Danh sách</a></div></div>@{var photos=ViewBag.Anh as List<string> ?? new List<string>();}
<div class="panel mb-3"><h3>Ảnh thiết bị / dòng máy</h3><div class="row g-3 mt-1">@foreach(var photo in photos){<div class="col-md-4"><img class="device-photo" src="@photo" alt="Ảnh @Model.DongMay?.TenDongMay" /></div>}@if(!photos.Any()){<p class="text-muted">Dòng máy chưa có ảnh. Bạn có thể tải ảnh trong trang chỉnh sửa.</p>}</div></div><div class="dashboard-grid"><div class="panel"><h3>Thông tin thiết bị</h3><div class="detail-grid mt-4"><div><span>Thương hiệu</span><b>@Model.DongMay?.ThuongHieu?.TenThuongHieu</b></div><div><span>Chi nhánh</span><b>@Model.CuaHang?.TenCuaHang (@Model.MaCuaHang)</b><small class="d-block">@Model.CuaHang?.DiaChi</small></div><div><span>Dòng máy</span><b>@Model.DongMay?.TenDongMay (@Model.MaDongMay)</b></div><div><span>Serial</span><b>@Model.SoSerial</b></div><div><span>Mô tả dòng máy</span><b>@Model.DongMay?.MoTa</b></div><div><span>Giá thuê/ngày</span><b class="money">@Model.DongMay?.GiaThueNgay.ToString("N0")đ</b></div><div><span>Tiền cọc</span><b>@Model.DongMay?.TienCoc.ToString("N0")đ</b></div><div><span>Tình trạng</span><b>@Model.TinhTrang.Replace("_"," ")</b></div><div><span>Trạng thái</span><b>@Model.TrangThai.Replace("_"," ")</b></div><div><span>Ngày nhập</span><b>@Model.NgayNhap?.ToString("dd/MM/yyyy")</b></div><div><span>Giảm giá</span><b>@Model.DongMay?.PhanTramGiamGia.ToString("0.##")%</b></div></div></div><div class="panel"><h3>Lịch thuê gần đây</h3>@if(!lich.Any()){<p class="muted mt-3">Chưa có lịch thuê.</p>}@foreach(var h in lich){<div class="report-row"><span><b>@h.MaHopDong</b><br><small>@h.ThoiGianBanGiao.ToString("dd/MM HH:mm") → @h.ThoiGianTraDuKien.ToString("dd/MM HH:mm")</small></span><span class="badge-soft">@h.TrangThai.Replace("_"," ")</span></div>}</div></div><div class="panel mt-3"><form method="post" asp-action="Delete" onsubmit="return confirm('Bạn chắc chắn muốn xóa thiết bị này?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.MaThietBi"><button class="btn btn-outline-danger"><i class="bi bi-trash"></i> Xóa thiết bị</button><small class="muted ms-2">Thiết bị đã phát sinh hợp đồng sẽ không được phép xóa.</small></form></div>
