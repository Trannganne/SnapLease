@model DeviceVM
@{
    ViewData["Title"] = "Quản lý thiết bị";
    var groups = Model.Items.GroupBy(x => x.MaDongMay).OrderBy(g => g.First().DongMay?.TenDongMay).ToList();
    var q = Context.Request.Query["q"].ToString();
    var status = Context.Request.Query["status"].ToString();
    var category = Context.Request.Query["category"].ToString();
    var brand = Context.Request.Query["brand"].ToString();
    var mode = Context.Request.Query["mode"].ToString() == "physical" ? "physical" : "models";
    string StatusName(string value) => value switch { "SAN_SANG" => "Sẵn sàng", "DANG_THUE" => "Đang thuê", "DANG_GIU" => "Đang giữ", "BAO_TRI" => "Bảo trì", "HONG" => "Hỏng", "NGUNG_KINH_DOANH" => "Ngừng kinh doanh", _ => value.Replace("_", " ") };
}
<link rel="stylesheet" href="~/css/pages/equipment-grid.css" asp-append-version="true" />
<div class="page-head sl-single-head equipment-heading">
    <div><h1>Quản lý thiết bị</h1><p>Quản lý dòng máy và thiết bị vật lý của cửa hàng</p></div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm thiết bị</a>
</div>
<section class="panel equipment-filters" aria-label="Bộ lọc thiết bị">
    <form method="get" asp-action="Index" class="equipment-filter-grid">
        <input type="hidden" name="mode" value="@mode" />
        <div class="equipment-search"><label for="equipment-q">Tìm kiếm</label><input id="equipment-q" class="form-control" name="q" value="@q" placeholder="Tên dòng máy, mã thiết bị hoặc serial..." /></div>
        <div><label for="equipment-category">Danh mục</label><select id="equipment-category" class="form-select" name="category"><option value="">Tất cả</option>@foreach(var c in Model.DanhMuc){<option value="@c.MaDanhMuc" selected="@(category==c.MaDanhMuc)">@c.TenDanhMuc</option>}</select></div>
        <div><label for="equipment-brand">Thương hiệu</label><select id="equipment-brand" class="form-select" name="brand"><option value="">Tất cả</option>@foreach(var b in Model.ThuongHieu){<option value="@b.MaThuongHieu" selected="@(brand==b.MaThuongHieu)">@b.TenThuongHieu</option>}</select></div>
        <div><label for="equipment-status">Trạng thái</label><select id="equipment-status" class="form-select" name="status"><option value="">Tất cả</option>@foreach(var s in new[]{"SAN_SANG","DANG_GIU","DANG_THUE","BAO_TRI","HONG","NGUNG_KINH_DOANH"}){<option value="@s" selected="@(status==s)">@StatusName(s)</option>}</select></div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Lọc</button>
        <a class="btn btn-outline-primary" asp-action="Index" asp-route-mode="@mode"><i class="bi bi-arrow-clockwise"></i> Đặt lại</a>
    </form>
</section>
<nav class="equipment-mode-tabs" aria-label="Chế độ xem thiết bị">
    <a class="@(mode=="models"?"active":"")" asp-action="Index" asp-route-q="@q" asp-route-category="@category" asp-route-brand="@brand" asp-route-status="@status" asp-route-mode="models"><i class="bi bi-grid"></i> Dòng máy</a>
    <a class="@(mode=="physical"?"active":"")" asp-action="Index" asp-route-q="@q" asp-route-category="@category" asp-route-brand="@brand" asp-route-status="@status" asp-route-mode="physical"><i class="bi bi-hdd"></i> Thiết bị vật lý</a>
</nav>
@if(mode=="models") {
    <div class="equipment-card-grid">
        @foreach(var group in groups) {
            var first = group.First(); var d = first.DongMay;
            var photo = Model.Anh.GetValueOrDefault(group.Key, "/images/device1.png");
            var available = group.Count(x=>x.TrangThai=="SAN_SANG");
            var rented = group.Count(x=>x.TrangThai=="DANG_THUE");
            var maintenance = group.Count(x=>x.TrangThai=="BAO_TRI");
            <article class="equipment-product-card">
                <div class="equipment-product-top">
                    <img src="@photo" alt="@d?.TenDongMay" loading="lazy" onerror="this.onerror=null;this.src='/images/device1.png'" />
                    <div class="equipment-product-info">
                        <div class="equipment-tags"><span>@group.Key</span><span>@d?.ThuongHieu?.TenThuongHieu</span></div>
                        <h2>@d?.TenDongMay</h2>
                        <p>@(string.IsNullOrWhiteSpace(d?.MoTa) ? "Thiết bị cho thuê" : d.MoTa)</p>
                        <strong>@d?.GiaThueNgay.ToString("N0") đ/ngày</strong>
                    </div>
                </div>
                <div class="equipment-counts">
                    <div><span>Tổng thiết bị</span><strong>@group.Count() máy</strong></div>
                    <div><span>Sẵn sàng</span><strong class="is-ready">@available máy</strong></div>
                    <div><span>Đang thuê</span><strong class="is-rented">@rented máy</strong></div>
                    <div><span>Bảo trì</span><strong class="is-maintenance">@maintenance máy</strong></div>
                </div>
                <a class="btn btn-outline-primary equipment-view" asp-action="Index" asp-route-mode="physical" asp-route-modelId="@group.Key" asp-route-category="@category" asp-route-brand="@brand"><i class="bi bi-camera"></i> Xem thiết bị <i class="bi bi-arrow-right"></i></a>
            </article>
        }
    </div>
} else {
    <section class="panel equipment-physical-panel">
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Thiết bị</th><th>Dòng máy</th><th>Serial</th><th>Tình trạng</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>
        @foreach(var x in Model.Items.OrderBy(x=>x.DongMay?.TenDongMay).ThenBy(x=>x.MaThietBi)) {
            <tr><td><strong>@x.MaThietBi</strong></td><td>@x.DongMay?.TenDongMay</td><td><code>@x.SoSerial</code></td><td>@x.TinhTrang.Replace("_"," ")</td><td><span class="badge-soft @x.TrangThai.ToLower()">@StatusName(x.TrangThai)</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.MaThietBi">Chi tiết</a> <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@x.MaThietBi">Chỉnh sửa</a></td></tr>
        }
        </tbody></table></div>
    </section>
}
@if(!Model.Items.Any()) { <div class="panel text-center py-5"><i class="bi bi-camera fs-2"></i><h3>Không tìm thấy thiết bị</h3><p>Thử thay đổi bộ lọc hoặc từ khóa.</p><a class="btn btn-outline-primary" asp-action="Index">Xóa bộ lọc</a></div> }
