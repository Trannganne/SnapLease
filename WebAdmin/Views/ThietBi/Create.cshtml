@model RentalCamera.Models.ThietBi
@{ViewData["Title"]="Thêm thiết bị";}<div class="page-head"><div><h1>Thêm thiết bị mới</h1><p>Khai báo thiết bị vật lý và đưa vào kho cho thuê</p></div><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div><div class="panel"><form method="post" enctype="multipart/form-data" class="row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-6"><label>Mã thiết bị</label><input asp-for="MaThietBi" class="form-control" required></div><div class="col-md-6"><label>Serial</label><input asp-for="SoSerial" class="form-control" required></div><div class="col-md-6"><label>Dòng máy</label><select asp-for="MaDongMay" class="form-select">@foreach(var x in (IEnumerable<RentalCamera.Models.DongMay>)ViewBag.DongMay){<option value="@x.MaDongMay">@x.TenDongMay</option>}</select></div><div class="col-md-6"><label>Cửa hàng</label><select asp-for="MaCuaHang" class="form-select">@foreach(var x in (IEnumerable<RentalCamera.Models.CuaHang>)ViewBag.CuaHang){<option value="@x.MaCuaHang">@x.TenCuaHang</option>}</select></div><div class="col-md-4"><label>Tình trạng</label><select asp-for="TinhTrang" class="form-select"><option value="TOT">Tốt</option><option value="TRAY_XUOC">Trầy xước</option><option value="CAN_KIEM_TRA">Cần kiểm tra</option><option value="HONG">Hỏng</option></select></div><div class="col-md-4"><label>Trạng thái</label><select asp-for="TrangThai" class="form-select"><option value="SAN_SANG">Sẵn sàng</option><option value="BAO_TRI">Bảo trì</option><option value="HONG">Hỏng</option></select></div><div class="col-md-4"><label>Ngày nhập</label><input asp-for="NgayNhap" type="date" class="form-control"></div><div class="col-12"><label class="form-label">Ảnh thiết bị (JPG, PNG, WebP; tối đa 5 MB)</label><input class="form-control" type="file" name="anh" accept="image/jpeg,image/png,image/webp"/><small class="text-muted">Ảnh được lưu theo dòng máy và dùng chung cho các thiết bị cùng dòng.</small></div><div class="col-12"><button class="btn btn-primary"><i class="bi bi-check2"></i> Lưu thiết bị</button></div></form></div>
