@model IEnumerable<RentalCamera.Models.DongMay>
@{ViewData["Title"]="Quản lý giá thuê";}<div class="page-head"><div><h1>Quản lý giá thuê</h1><p>Cập nhật đơn giá, tiền cọc và mức giảm giá cho từng dòng máy</p></div></div><div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Dòng máy</th><th>Thương hiệu</th><th>Giá/ngày</th><th>Tiền cọc</th><th>Giảm giá (%)</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><form method="post" asp-action="Update">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.MaDongMay"><td><b>@x.TenDongMay</b><br><small class="muted">@x.MaDongMay</small></td><td>@x.ThuongHieu?.TenThuongHieu</td><td><input class="form-control" type="number" min="0" name="giaThueNgay" value="@x.GiaThueNgay.ToString("0")"></td><td><input class="form-control" type="number" min="0" name="tienCoc" value="@x.TienCoc.ToString("0")"></td><td><input class="form-control" type="number" min="0" max="100" step="0.01" name="phanTramGiamGia" value="@x.PhanTramGiamGia.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)"></td><td><button class="btn btn-primary btn-sm">Lưu giá</button></td></form></tr>}</tbody></table></div></div>
