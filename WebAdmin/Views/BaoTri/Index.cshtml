@model List<ThietBi>
@{ViewData["Title"]="Bảo trì & Sửa chữa";}<div class="page-head"><div><h1>Bảo trì & Sửa chữa</h1><p>Kiểm soát hỏng và lịch bảo dưỡng định kỳ các thiết bị quay chụp</p></div></div><div class="panel mb-3"><h3>Chọn thiết bị cần bảo trì / sửa chữa</h3><form asp-action="SetStatus" method="post" class="row g-2 align-items-end">@Html.AntiForgeryToken()<div class="col-md-5"><label class="form-label">Thiết bị</label><select class="form-select" name="id" required><option value="">-- Chọn thiết bị --</option>@foreach(var d in (IEnumerable<ThietBi>)ViewBag.AllDevices){<option value="@d.MaThietBi">@d.MaThietBi - @d.DongMay?.TenDongMay (@d.TrangThai)</option>}</select></div><div class="col-md-3"><label class="form-label">Trạng thái mới</label><select class="form-select" name="status"><option value="BAO_TRI">Bảo trì</option><option value="HONG">Hỏng</option><option value="SAN_SANG">Hoàn tất / sẵn sàng</option><option value="NGUNG_KINH_DOANH">Ngừng sử dụng</option></select></div><div class="col-md-3"><label class="form-label">Tình trạng thực tế</label><input class="form-control" name="tinhTrang" placeholder="Ví dụ: Cần kiểm tra ống kính" /></div><div class="col-md-1"><button class="btn btn-primary">Lưu</button></div></form></div><div class="stats compact"><div class="stat"><span>Tổng cần xử lý</span><strong>@Model.Count</strong></div><div class="stat"><span>Đang bảo trì</span><strong>@Model.Count(x=>x.TrangThai=="BAO_TRI")</strong></div><div class="stat"><span>Hỏng</span><strong>@Model.Count(x=>x.TrangThai=="HONG")</strong></div></div><div class="panel mt-3"><table class="table"><thead><tr><th>Thiết bị</th><th>Mã SKU</th><th>Vấn đề</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.DongMay?.TenDongMay</td><td>@x.MaThietBi</td><td>@x.TinhTrang</td><td><span class="badge-soft">@x.TrangThai</span></td><td><form asp-action="SetStatus" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@x.MaThietBi"><input type="hidden" name="tinhTrang" value="TOT"><button name="status" value="BAO_TRI" class="btn btn-sm btn-outline-primary">Bảo trì</button><button name="status" value="SAN_SANG" class="btn btn-sm btn-success">Hoàn tất</button><button name="status" value="NGUNG_KINH_DOANH" class="btn btn-sm btn-outline-danger">Ngừng dùng</button></form></td></tr>}</tbody></table></div>
