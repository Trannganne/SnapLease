@model IEnumerable<RentalCamera.Controllers.PenaltyRowVM>
@{ViewData["Title"]="Quản lý phí phạt";}<div class="page-head"><div><h1>Quản lý phí phạt</h1><p>Theo dõi phí trả trễ, hư hỏng, mất phụ kiện và các vi phạm hợp đồng</p></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Lập phiếu phạt</a></div><div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Mã phiếu</th><th>Hợp đồng</th><th>Thiết bị</th><th>Loại vi phạm</th><th>Số tiền</th><th>Ngày lập</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td><b>@r.Phieu.MaPhieuPhat</b></td><td>@r.MaHopDong</td><td>@r.MaThietBi</td><td>@r.Phieu.LoaiViPham.Replace("_"," ")<br><small class="muted">@r.Phieu.MoTa</small></td><td class="money"><b>@r.Phieu.SoTien.ToString("N0")đ</b></td><td>@r.Phieu.NgayLap.ToString("dd/MM/yyyy")</td><td><span class="badge-soft">@r.Phieu.TrangThai.Replace("_"," ")</span></td><td>@if(r.Phieu.TrangThai!="DA_THANH_TOAN"){<form method="post" asp-action="SetStatus">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Phieu.MaPhieuPhat"><input type="hidden" name="status" value="DA_THANH_TOAN"><button class="btn btn-outline-success btn-sm">Đã thu</button></form>}</td></tr>}</tbody></table></div></div>
