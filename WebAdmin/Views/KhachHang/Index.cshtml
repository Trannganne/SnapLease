@model List<KhachThue>
@{ViewData["Title"]="Quản lý khách hàng";}<div class="page-head"><div><h1>Quản lý khách hàng</h1><p>Danh sách hội viên và khách hàng thuê máy quay RENTALCAMERA</p></div></div><div class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Khách hàng</th><th>Số điện thoại</th><th>Email</th><th>CCCD</th><th>Địa chỉ</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.HoTen</b></td><td>@x.SoDienThoai</td><td>@x.Email</td><td>@x.CCCD</td><td>@x.DiaChi</td><td><a asp-action="Details" asp-route-id="@x.MaKhachThue" class="btn btn-outline-primary btn-sm">Chi tiết</a></td></tr>}</tbody></table></div></div>
