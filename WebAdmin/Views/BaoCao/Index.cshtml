@model ReportVM
<div class="panel mb-3"><div class="d-flex justify-content-between align-items-center flex-wrap gap-2"><h3>So sánh doanh thu theo kỳ</h3><form method="get" class="d-flex gap-2"><select class="form-select" name="ky"><option value="thang" selected="@(ViewBag.Ky=="thang")">Theo tháng</option><option value="tuan" selected="@(ViewBag.Ky=="tuan")">Theo tuần</option></select><button class="btn btn-primary">Xem</button></form></div><div class="row g-3 mt-1"><div class="col-md-6"><div class="stat"><span>Kỳ hiện tại: @ViewBag.KyHienTai</span><strong>@(((decimal)ViewBag.DoanhThuHienTai).ToString("N0")) đ</strong></div></div><div class="col-md-6"><div class="stat"><span>Kỳ trước: @ViewBag.KyTruoc</span><strong>@(((decimal)ViewBag.DoanhThuTruoc).ToString("N0")) đ</strong></div></div></div>@{decimal current=(decimal)ViewBag.DoanhThuHienTai;decimal previous=(decimal)ViewBag.DoanhThuTruoc;}<p class="mt-3 mb-0">Chênh lệch: <strong>@((current-previous).ToString("+0;-0;0")) đ</strong> @if(previous>0){<span>(@(((current-previous)/previous*100).ToString("+0.0;-0.0;0"))%)</span>}else{<span>(không tính tỷ lệ khi kỳ trước bằng 0)</span>}</p></div>

@{ViewData["Title"]="Báo cáo thống kê";}<div class="page-head"><div><h1>Báo cáo doanh thu & vận hành</h1><p>Tổng hợp doanh thu, đơn thuê và tình trạng thiết bị</p></div><button class="btn btn-outline-primary" onclick="window.print()"><i class="bi bi-printer"></i> In / Xuất PDF</button></div><div class="stats"><div class="stat"><span>Tổng doanh thu</span><strong>@Model.DoanhThu.ToString("N0")đ</strong><em>Không tính tiền cọc</em></div><div class="stat"><span>Đơn thuê hợp lệ</span><strong>@Model.DonThanhCong</strong><em>Không tính đơn đã hủy</em></div><div class="stat"><span>Tổng thiết bị</span><strong>@Model.TongThietBi</strong></div><div class="stat"><span>Tỷ lệ đang khai thác</span><strong>@Model.TyLeLapDay.ToString("0.0")%</strong></div></div><div class="dashboard-grid mt-3"><div class="panel"><h3>Doanh thu theo loại</h3>@foreach(var x in Model.DoanhThuTheoLoai){<div class="report-row"><span>@x.Key.Replace("_"," ")</span><b>@x.Value.ToString("N0")đ</b></div>}@if(!Model.DoanhThuTheoLoai.Any()){<p class="muted mt-3">Chưa có thanh toán thành công.</p>}</div><div class="panel"><h3>Tình trạng thiết bị</h3>@foreach(var x in Model.TinhTrangThietBi.OrderByDescending(x=>x.Value)){var pct=Model.TongThietBi==0?0:(double)x.Value/Model.TongThietBi*100;<div class="status-row"><div><span>@x.Key.Replace("_"," ")</span><b>@x.Value <small>@pct.ToString("0")%</small></b></div><div class="progress"><div class="progress-bar" style="width:@pct.ToString("0",System.Globalization.CultureInfo.InvariantCulture)%"></div></div></div>}</div></div><div class="panel mt-3"><h3>Đơn thuê theo trạng thái</h3><div class="row">@foreach(var x in Model.DonTheoTrangThai.OrderByDescending(x=>x.Value)){<div class="col-md-3"><div class="report-row"><span>@x.Key.Replace("_"," ")</span><b>@x.Value đơn</b></div></div>}</div></div>
