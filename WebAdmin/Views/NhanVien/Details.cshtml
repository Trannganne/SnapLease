@model NhanVien
@{ViewData["Title"]="Chi tiết nhân viên";var branch=ViewBag.Branch as CuaHang;var contracts=ViewBag.Contracts as List<HopDong> ?? new();}
<div class="page-head"><div><h1>@Model.HoTen</h1><p>@Model.MaNhanVien · @Model.ChucVu</p></div><div class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@Model.MaNhanVien" class="btn btn-primary">Chỉnh sửa</a><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div></div>
<div class="panel"><h3>Thông tin nhân viên</h3><div class="detail-grid mt-3"><div><span>Chi nhánh</span><b>@branch?.TenCuaHang</b></div><div><span>Điện thoại</span><b>@Model.SoDienThoai</b></div><div><span>Email</span><b>@Model.Email</b></div><div><span>Địa chỉ</span><b>@Model.DiaChi</b></div><div><span>Trạng thái</span><b>@Model.TrangThai</b></div></div></div>
<div class="panel mt-3"><h3>Lịch sử hợp đồng liên quan đến nhân viên</h3><p class="text-muted">Hiện hệ thống chưa có nguồn dữ liệu nhật ký thao tác riêng. Bảng dưới đây chỉ thể hiện các hợp đồng gắn với mã nhân viên.</p><div class="table-responsive"><table class="table"><thead><tr><th>Mã hợp đồng</th><th>Ngày ký</th><th>Trạng thái</th><th>Tổng tiền</th></tr></thead><tbody>@foreach(var h in contracts){<tr><td>@h.MaHopDong</td><td>@h.NgayKy.ToString("dd/MM/yyyy HH:mm")</td><td>@h.TrangThai</td><td>@h.TongTien.ToString("N0") đ</td></tr>}@if(!contracts.Any()){<tr><td colspan="4">Chưa có hợp đồng liên quan.</td></tr>}</tbody></table></div></div>
<div class="panel mt-3"><form method="post" asp-action="Delete" onsubmit="return confirm('Xóa nhân viên này? Thao tác không thể hoàn tác.')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.MaNhanVien"/><button type="submit" class="btn btn-outline-danger">Xóa nhân viên</button><small class="text-muted ms-2">Không xóa được nhân viên đã có hợp đồng hoặc dữ liệu liên quan.</small></form></div>
