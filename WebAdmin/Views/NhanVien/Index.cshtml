@model List<NhanVien>
@{ ViewData["Title"]="Nhân viên & phân quyền"; var branches=ViewBag.Branches as List<CuaHang> ?? new(); var names=branches.ToDictionary(x=>x.MaCuaHang,x=>x.TenCuaHang); }
<div class="page-head"><div><h1>Nhân viên & phân quyền</h1><p>Theo dõi nhân sự và chi nhánh được phân công</p></div></div>
<form method="get" class="panel sl-admin-filter sl-admin-filters"><label>Chi nhánh<select class="form-select" name="chiNhanh"><option value="">Tất cả chi nhánh</option>@foreach(var b in branches){<option value="@b.MaCuaHang" selected="@(ViewBag.ChiNhanh==b.MaCuaHang)">@b.TenCuaHang</option>}</select></label><label>Tìm nhân viên<input class="form-control" name="q" value="@ViewBag.Q" placeholder="Mã hoặc họ tên" /></label><button class="btn btn-primary" type="submit">Lọc</button><a asp-action="Index" class="btn btn-outline-primary">Đặt lại</a></form>
<div class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Mã nhân viên</th><th>Họ tên</th><th>Chức vụ</th><th>Chi nhánh</th><th>Liên hệ</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var n in Model){<tr><td><strong>@n.MaNhanVien</strong></td><td>@n.HoTen</td><td>@n.ChucVu</td><td>@(names.GetValueOrDefault(n.MaCuaHang,n.MaCuaHang))</td><td>@n.SoDienThoai <small class="d-block text-muted">@n.Email</small></td><td><span class="badge-soft">@n.TrangThai.Replace("_"," ")</span></td><td><a asp-action="Details" asp-route-id="@n.MaNhanVien" class="btn btn-sm btn-outline-primary">Chi tiết</a> <a asp-action="Edit" asp-route-id="@n.MaNhanVien" class="btn btn-sm btn-outline-secondary">Sửa</a></td></tr>}
@if(Model.Count==0){<tr><td colspan="7" class="text-center py-4 text-muted">Không có nhân viên phù hợp.</td></tr>}
</tbody></table></div></div>
<div class="sl-admin-note">Nhật ký dưới trang chi tiết là lịch sử hợp đồng liên quan đến nhân viên, không phải nhật ký thao tác hệ thống. Chỉ cấp quyền sửa/xóa cho quản trị viên khi triển khai thực tế.</div>
